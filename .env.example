# PostgreSQL 17 (la base Docker es independiente de tu PostgreSQL local)
POSTGRES_DB=huellitas_felices
POSTGRES_USER=huellitas_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE

# Correo SMTP
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SenderName=Huellitas Felices
EmailSettings__SenderEmail=tu_correo@gmail.com
EmailSettings__Password=TU_CONTRASENA_DE_APLICACION

# PayPal Sandbox
PaymentSettings__PayPal__ClientId=TU_PAYPAL_CLIENT_ID
PaymentSettings__PayPal__ClientSecret=TU_PAYPAL_CLIENT_SECRET
PaymentSettings__PayPal__BaseUrl=https://api-m.sandbox.paypal.com
PaymentSettings__PayPal__ReturnUrl=http://localhost:8080/Payment/Success
PaymentSettings__PayPal__CancelUrl=http://localhost:8080/Payment/Cancel

# PayPhone
PayPhone__Token=TU_PAYPHONE_TOKEN
PayPhone__StoreId=TU_PAYPHONE_STORE_ID
PayPhone__BaseUrl=https://pay.payphonetodoesposible.com

# Google (opcional)
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# IA (opcional; desde un contenedor, localhost no apunta a tu host)
AI__BaseUrl=
AI__ModelName=
AI__TimeoutSeconds=60
