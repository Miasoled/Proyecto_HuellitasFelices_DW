@{ ViewData["Title"] = "Clientes con Más Compras"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Clientes frecuentes</li>
        </ol></nav>
        <h1><i class="bi bi-people me-2"></i>Clientes con Más Compras</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="hf-card mb-4">
        <p class="fw-bold mb-2">Top @ViewBag.Total clientes por monto total en consultas</p>
    </div>

    <div class="hf-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr>
                    <th>#</th><th>Cliente</th><th>Email</th>
                    <th>Mascotas</th><th>Consultas</th><th>Monto Total</th>
                </tr></thead>
                <tbody>
                @{
                    int rank = 1;
                    foreach (dynamic item in Model)
                    {
                        <tr>
                            <td>@(rank++)</td>
                            <td>@item.Nombre</td>
                            <td>@item.Email</td>
                            <td>@item.TotalMascotas</td>
                            <td>@item.TotalConsultas</td>
                            <td><strong>$@(((decimal)item.MontoTotal).ToString("N2"))</strong></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div></div>
