@{ ViewData["Title"] = "Reporte de MFA"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">MFA</li>
        </ol></nav>
        <h1><i class="bi bi-shield-lock me-2"></i>Usuarios con MFA</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="hf-card text-center p-3">
                <i class="bi bi-people text-primary fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.Total</p>
                <small class="text-muted">Total usuarios</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="hf-card text-center p-3">
                <i class="bi bi-shield-check text-success fs-3"></i>
                <p class="fw-bold fs-4 mb-0 text-success">@ViewBag.ConMFA</p>
                <small class="text-muted">Con MFA habilitado</small>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="hf-card text-center p-3">
                <i class="bi bi-shield-x text-warning fs-3"></i>
                <p class="fw-bold fs-4 mb-0 text-warning">@ViewBag.SinMFA</p>
                <small class="text-muted">Sin MFA</small>
            </div>
        </div>
    </div>

    <div class="hf-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr>
                    <th>Email</th><th>Rol</th><th>MFA Habilitado</th>
                </tr></thead>
                <tbody>
                @foreach (dynamic item in Model)
                {
                    <tr>
                        <td>@item.Email</td>
                        <td><span class="badge bg-secondary">@item.Rol</span></td>
                        <td>
                            @if (item.MFAHabilitado)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-x-circle me-1"></i>No</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div></div>
