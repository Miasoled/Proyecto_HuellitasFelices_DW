@model IEnumerable<HuellitasFelices.Models.ResumenMotivo>
@{ ViewData["Title"] = "Reporte de Servicios"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Servicios</li>
        </ol></nav>
        <h1><i class="bi bi-gear-wide-connected me-2"></i>Reporte de servicios</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>Motivo / Servicio</th><th>Cantidad</th><th>Total Ingresos</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Motivo</strong></td>
                        <td><span class="badge-info-hf">@item.Cantidad</span></td>
                        <td><span class="badge-success-hf">$@item.TotalIngresos.ToString("N2")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
</div></div>
