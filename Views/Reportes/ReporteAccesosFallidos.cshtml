@model IEnumerable<HuellitasFelices.Models.AuditLog>
@{ ViewData["Title"] = "Intentos de Acceso Fallidos"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Accesos fallidos</li>
        </ol></nav>
        <h1><i class="bi bi-shield-exclamation me-2"></i>Intentos de Acceso Fallidos</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <label class="form-label">Desde</label>
            <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">Hasta</label>
            <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Filtrar</button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-shield-exclamation text-danger fs-3"></i>
                <p class="fw-bold fs-4 mb-0 text-danger">@ViewBag.Total</p>
                <small class="text-muted">Intentos fallidos</small>
            </div>
        </div>
    </div>

    <div class="hf-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr>
                    <th>Fecha</th><th>Usuario</th><th>IP</th><th>Acción</th><th>Descripción</th>
                </tr></thead>
                <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(log.UsuarioEmail ?? "Desconocido")</td>
                        <td>@(log.DireccionIP ?? "N/A")</td>
                        <td><span class="badge bg-danger">@log.Accion</span></td>
                        <td>@(log.Descripcion ?? log.ValorNuevo ?? "N/A")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div></div>
<partial name="_Paginacion" model="ViewBag.Paginacion" />
