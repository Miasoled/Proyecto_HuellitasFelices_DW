@model IEnumerable<HuellitasFelices.Models.SolicitudAdopcion>
@{ ViewData["Title"] = "Reporte de Adopciones"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Adopciones</li>
        </ol></nav>
        <h1><i class="bi bi-journal-heart me-2"></i>Reporte de adopciones</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-journal-heart text-primary fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.Total</p>
                <small class="text-muted">Total solicitudes</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-check-circle text-success fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.Aprobadas</p>
                <small class="text-muted">Aprobadas</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-clock text-warning fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.Pendientes</p>
                <small class="text-muted">Pendientes</small>
            </div>
        </div>
    </div>

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>Solicitante</th><th>Animal</th><th>Teléfono</th><th>Email</th><th>Estado</th><th>Fecha</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Estado switch {
                        "Aprobada"   => "badge-success-hf",
                        "Pendiente"  => "badge-warning-hf",
                        "Rechazada"  => "badge-danger-hf",
                        "Cancelada"  => "badge-danger-hf",
                        _            => "badge-warning-hf"
                    };
                    <tr>
                        <td><strong>@item.NombreSolicitante</strong></td>
                        <td style="font-size:.88rem">@item.AnimalAdopcion?.Nombre</td>
                        <td style="font-size:.88rem">@item.Telefono</td>
                        <td style="font-size:.88rem; color:var(--text-soft)">@(item.Email ?? "—")</td>
                        <td><span class="@badgeClass">@item.Estado</span></td>
                        <td style="font-size:.85rem; color:var(--text-soft)">@item.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
</div></div>
