@model IEnumerable<HuellitasFelices.Models.AuditLog>
@{ ViewData["Title"] = "Reporte de Auditoría"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Auditoría</li>
        </ol></nav>
        <h1><i class="bi bi-shield-lock me-2"></i>Reporte de auditoría</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <form method="get" class="search-bar d-flex gap-2 flex-wrap mb-4">
        <label class="align-self-center fw-semibold">Acción:</label>
        <select name="accion" class="form-select" style="width:auto">
            <option value="">Todas</option>
            @foreach (var a in (ViewBag.Acciones as List<string>) ?? new List<string>())
            {
                <option value="@a" selected="@(ViewBag.Accion as string == a)">@a</option>
            }
        </select>
        <label class="align-self-center fw-semibold">Entidad:</label>
        <select name="entidad" class="form-select" style="width:auto">
            <option value="">Todas</option>
            @foreach (var e in (ViewBag.Entidades as List<string>) ?? new List<string>())
            {
                <option value="@e" selected="@(ViewBag.Entidad as string == e)">@e</option>
            }
        </select>
        <button type="submit" class="btn-search"><i class="bi bi-search"></i> Filtrar</button>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-shield-lock text-primary fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.TotalRegistros</p>
                <small class="text-muted">Total registros</small>
            </div>
        </div>
    </div>

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>Fecha</th><th>Acción</th><th>Entidad</th><th>ID Entidad</th><th>Usuario Email</th><th>IP</th><th>Descripción</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-size:.85rem; color:var(--text-soft)">@item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge-info-hf">@item.Accion</span></td>
                        <td style="font-size:.88rem; font-weight:600">@item.Entidad</td>
                        <td>@(item.IdentificadorEntidad?.ToString() ?? "—")</td>
                        <td style="font-size:.88rem; color:var(--text-soft)">@(item.UsuarioEmail ?? "—")</td>
                        <td style="font-size:.85rem; color:var(--text-soft)">@(item.DireccionIP ?? "—")</td>
                        <td style="font-size:.85rem; color:var(--text-soft)">@(item.Descripcion ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>

    @{
        int paginaActual = (int)ViewBag.PaginaActual;
        int totalPaginas = (int)ViewBag.TotalPaginas;
    }
    @if (totalPaginas > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="ReporteAuditoria"
                       asp-route-pagina="@(paginaActual - 1)"
                       asp-route-accion="@ViewBag.Accion"
                       asp-route-entidad="@ViewBag.Entidad">Anterior</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Página @paginaActual de @totalPaginas</span></li>
                <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="ReporteAuditoria"
                       asp-route-pagina="@(paginaActual + 1)"
                       asp-route-accion="@ViewBag.Accion"
                       asp-route-entidad="@ViewBag.Entidad">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div></div>
