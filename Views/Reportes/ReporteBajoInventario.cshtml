@{ ViewData["Title"] = "Productos con Bajo Inventario"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Bajo inventario</li>
        </ol></nav>
        <h1><i class="bi bi-exclamation-triangle me-2"></i>Productos con Bajo Inventario</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-exclamation-triangle text-danger fs-3"></i>
                <p class="fw-bold fs-4 mb-0 text-danger">@ViewBag.Total</p>
                <small class="text-muted">Productos bajo mínimo</small>
            </div>
        </div>
    </div>

    <div class="hf-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr>
                    <th>Producto</th><th>Categoría</th>
                    <th>Stock Mínimo</th><th>Stock Actual</th><th>Precio Venta</th>
                </tr></thead>
                <tbody>
                @{
                    foreach (dynamic item in Model)
                    {
                        <tr class="@(item.StockActual == 0 ? "table-danger" : "table-warning")">
                            <td>@item.Nombre</td>
                            <td>@item.Categoria</td>
                            <td>@item.StockMinimo</td>
                            <td><strong>@item.StockActual</strong></td>
                            <td>$@(((decimal)item.PrecioVenta).ToString("N2"))</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div></div>
