@model IEnumerable<HuellitasFelices.Models.Empleado>
@{ ViewData["Title"] = "Reporte de Empleados"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Reportes</a></li>
            <li class="breadcrumb-item active">Empleados</li>
        </ol></nav>
        <h1><i class="bi bi-person-badge me-2"></i>Reporte de empleados</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-person-badge text-primary fs-3"></i>
                <p class="fw-bold fs-4 mb-0">@ViewBag.Total</p>
                <small class="text-muted">Total empleados</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="hf-card text-center p-3">
                <i class="bi bi-cash-stack text-success fs-3"></i>
                <p class="fw-bold fs-4 mb-0">$@(((decimal)ViewBag.SalarioTotal).ToString("N2"))</p>
                <small class="text-muted">Salario total</small>
            </div>
        </div>
    </div>

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>Nombre</th><th>Cargo</th><th>Teléfono</th><th>Salario</th><th>Estado</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nombre</strong></td>
                        <td><span class="badge-info-hf">@item.Cargo</span></td>
                        <td style="font-size:.88rem">@(item.Telefono ?? "—")</td>
                        <td><span class="badge-success-hf">$@item.Salario.ToString("N2")</span></td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge-success-hf">Activo</span>
                            }
                            else
                            {
                                <span class="badge-danger-hf">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
</div></div>
<partial name="_Paginacion" model="ViewBag.Paginacion" />
