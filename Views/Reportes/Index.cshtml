@model HuellitasFelices.Models.ReporteViewModel
@{ ViewData["Title"] = "Reportes"; }

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Reportes</li>
        </ol></nav>
        <h1><i class="bi bi-bar-chart-line-fill me-2"></i>Reportes y estadísticas</h1>
        <small style="opacity:.8">Panel de análisis en tiempo real</small>
    </div>
</div>

<div class="content-wrapper reports-dashboard"><div class="container">

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-item" style="flex-direction:row">
                <div class="stat-icon" style="background:var(--color-accent-lighter)"><i class="bi bi-clipboard2-pulse-fill" style="color:var(--color-primary); font-size:1.4rem"></i></div>
                <div style="text-align:left">
                    <div style="font-size:1.3rem; font-weight:800; color:var(--color-primary); line-height:1">$@Model.TotalIngresosConsultas.ToString("N0")</div>
                    <div style="font-size:.78rem; color:var(--color-text-secondary)">Ingresos por consultas</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-item" style="flex-direction:row">
                <div class="stat-icon" style="background:var(--color-info-bg)"><i class="bi bi-calculator" style="color:var(--color-primary); font-size:1.4rem"></i></div>
                <div style="text-align:left">
                    <div style="font-size:1.3rem; font-weight:800; color:var(--color-primary); line-height:1">$@Model.PromedioCostoConsulta.ToString("N2")</div>
                    <div style="font-size:.78rem; color:var(--color-text-secondary)">Promedio por consulta</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Conteos -->
    <div class="hf-card mb-4">
        <div class="hf-card-header"><i class="bi bi-table"></i> Total de registros por tabla</div>
        <div class="card-body">
            <div class="row text-center g-3">
                @{
                    var items = new[] {
                        ("bi-patch-heart-fill","color:var(--color-success)", "var(--color-success-bg)", Model.TotalMascotas.ToString("N0"), "Total mascotas"),
                        ("bi-patch-heart","color:var(--color-success)", "var(--color-success-bg)", Model.MascotasActivas.ToString("N0"), "Activas"),
                        ("bi-dash-circle","color:var(--color-danger)", "var(--color-danger-bg)", Model.MascotasInactivas.ToString("N0"), "Inactivas"),
                        ("bi-people-fill","color:var(--color-primary)", "var(--color-accent-lighter)", Model.TotalDuenos.ToString("N0"), "Dueños"),
                        ("bi-clipboard2-pulse","color:var(--color-primary)", "var(--color-info-bg)", Model.TotalConsultas.ToString("N0"), "Consultas")
                    };
                }
                @foreach (var (icon, color, bg, val, label) in items)
                {
                    <div class="col-6 col-md-3 col-lg">
                        <div style="background:@bg; border-radius:14px; padding:20px 12px">
                            <i class="bi @icon" style="@color; font-size:1.6rem; display:block; margin-bottom:8px"></i>
                            <div style="font-size:1.4rem; font-weight:800; line-height:1" style="@color">@val</div>
                            <div style="font-size:.8rem; color:var(--color-text-secondary); margin-top:4px">@label</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Top 10 motivos -->
        <div class="col-lg-6">
            <div class="hf-card h-100">
                <div class="hf-card-header"><i class="bi bi-trophy-fill"></i> Top 10 motivos de consulta</div>
                <div class="table-responsive">
                    <table class="hf-table">
                        <thead><tr><th>#</th><th>Motivo</th><th>Consultas</th><th>Ingresos</th></tr></thead>
                        <tbody>
                            @{ int r = 1; }
                            @foreach (var item in Model.Top10Motivos)
                            {
                                <tr>
                                    <td><span class="badge-info" style="font-size:.78rem">@r</span></td>
                                    <td><strong style="font-size:.9rem">@item.Motivo</strong></td>
                                    <td><span class="badge-success">@item.Cantidad.ToString("N0")</span></td>
                                    <td style="font-size:.88rem; color:var(--color-primary)">$@item.TotalIngresos.ToString("N2")</td>
                                </tr>
                                r++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Top 10 dueños -->
        <div class="col-lg-6">
            <div class="hf-card h-100">
                <div class="hf-card-header"><i class="bi bi-people-fill"></i> Top 10 dueños con más mascotas</div>
                <div class="table-responsive">
                    <table class="hf-table">
                        <thead><tr><th>#</th><th>Dueño</th><th>Email</th><th>Mascotas</th></tr></thead>
                        <tbody>
                            @{ int r2 = 1; }
                            @foreach (var item in Model.Top10DuenosConMascotas)
                            {
                                <tr>
                                    <td><span class="badge-success" style="font-size:.78rem">@r2</span></td>
                                    <td><strong style="font-size:.9rem">@item.Nombre</strong></td>
                                    <td style="font-size:.82rem; color:var(--color-text-secondary)">@item.Email</td>
                                    <td><span class="badge-info">@item.TotalMascotas</span></td>
                                </tr>
                                r2++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Consultas por mes -->
        <div class="col-lg-5">
            <div class="hf-card h-100">
                <div class="hf-card-header"><i class="bi bi-calendar3"></i> Consultas por mes (últimos 12)</div>
                <div class="table-responsive">
                    <table class="hf-table">
                        <thead><tr><th>Mes</th><th>Consultas</th><th>Ingresos</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.ConsultasPorMes)
                            {
                                <tr>
                                    <td style="font-size:.88rem; font-weight:600">@item.NombreMes</td>
                                    <td><span class="badge-info">@item.TotalConsultas.ToString("N0")</span></td>
                                    <td style="color:var(--color-primary); font-size:.88rem">$@item.TotalIngresos.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:var(--color-accent-lighter)">
                                <td style="font-weight:700; font-size:.88rem">Total</td>
                                <td><span class="badge-success">@Model.ConsultasPorMes.Sum(c => c.TotalConsultas).ToString("N0")</span></td>
                                <td style="color:var(--color-primary); font-weight:700; font-size:.88rem">$@Model.ConsultasPorMes.Sum(c => c.TotalIngresos).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Empleados por cargo -->
        <div class="col-lg-4">
            <div class="hf-card h-100">
                <div class="hf-card-header"><i class="bi bi-person-badge"></i> Empleados por cargo</div>
                <div class="table-responsive">
                    <table class="hf-table">
                        <thead><tr><th>Cargo</th><th>Cant.</th><th>Salario prom.</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.EmpleadosPorCargo)
                            {
                                <tr>
                                    <td style="font-size:.88rem; font-weight:600">@item.Cargo</td>
                                    <td><span class="badge-info">@item.Cantidad</span></td>
                                    <td style="font-size:.88rem; color:var(--color-text-secondary)">$@item.SalarioPromedio.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Reportes disponibles -->
    <div class="hf-card reports-directory-section mb-4">
        <div class="hf-card-header"><i class="bi bi-files me-2"></i>Reportes disponibles</div>
        <div class="card-body">
            <div class="reports-directory">
                @{
                    var reportes = new[] {
                        ("ReporteConsultas", "bi-clipboard2-pulse", "color:var(--color-primary)", "Consultas"),
                        ("ReporteMascotas", "bi-patch-heart", "color:var(--color-success)", "Mascotas"),
                        ("ReporteDuenos", "bi-people", "color:var(--color-primary)", "Dueños"),
                        ("ReporteEmpleados", "bi-person-badge", "color:var(--color-warning)", "Empleados"),
                        ("ReporteAdopciones", "bi-heart", "color:var(--color-danger)", "Adopciones"),
                        ("ReporteServicios", "bi-gear", "color:#6b7280", "Servicios"),
                        ("ReporteInventario", "bi-box-seam", "color:var(--color-primary)", "Inventario"),
                        ("ReporteAuditoria", "bi-shield-check", "color:var(--color-danger)", "Auditoría"),
                        ("ReporteBajoInventario", "bi-exclamation-triangle", "color:var(--color-warning)", "Bajo inventario"),
                        ("ReporteVentas", "bi-graph-up-arrow", "color:var(--color-success)", "Ventas"),
                        ("ReporteClientesCompras", "bi-cart-check", "color:var(--color-primary)", "Clientes compras"),
                        ("ReporteProductosMasVendidos", "bi-star", "color:var(--color-warning)", "Productos vendidos"),
                        ("ReporteMFA", "bi-shield-lock", "color:var(--color-primary)", "MFA"),
                        ("ReporteAccesosFallidos", "bi-x-circle", "color:var(--color-danger)", "Accesos fallidos"),
                        ("ReportePagos", "bi-credit-card", "color:var(--color-success)", "Pagos"),
                    };
                }
                @foreach (var (accion, icono, color, titulo) in reportes)
                {
                    <a asp-action="@accion" class="report-directory-card text-decoration-none">
                        <span class="report-directory-icon"><i class="bi @icono" style="@color"></i></span>
                        <span class="report-directory-copy">
                            <strong>@titulo</strong>
                            <small>Ver análisis y detalles</small>
                        </span>
                        <i class="bi bi-arrow-up-right report-directory-arrow"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div></div>
