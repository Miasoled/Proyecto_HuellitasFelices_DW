@model IEnumerable<HuellitasFelices.Models.CarritoItem>
@{
    ViewData["Title"] = "Mi Carrito";
    var total = ViewBag.Total as decimal? ?? 0;
}

<!-- Carga del SDK de PayPal con el Client ID de ViewBag -->
<script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.ClientId&currency=USD"></script>

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tienda" asp-action="Index">Tienda</a></li>
            <li class="breadcrumb-item active">Carrito</li>
        </ol></nav>
        <h1><i class="bi bi-cart3 me-2"></i>Mi Carrito</h1>
    </div>
</div>

<div class="content-wrapper">
    <div class="container">

        @if (TempData["CarritoMensaje"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert" style="border:none;background:#dcfce7;color:#166534">
                <i class="bi bi-check-circle-fill me-2"></i>@msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="hf-card text-center" style="padding:60px 20px">
                <i class="bi bi-cart" style="font-size:4rem;color:var(--border);display:block;margin-bottom:16px"></i>
                <h4 style="font-weight:700;color:var(--text-soft)">Tu carrito está vacío</h4>
                <p style="color:var(--text-soft);font-size:.9rem">Explora nuestra tienda y encuentra productos increíbles para tu mascota.</p>
                <a asp-controller="Tienda" asp-action="Index" class="btn-primary-hf mt-3">
                    <i class="bi bi-bag-heart"></i> Ir a la tienda
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <!-- Lista de productos -->
                <div class="col-lg-8">
                    <div class="hf-card">
                        <div class="hf-card-header d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-bag-check me-2"></i>@Model.Count() producto(s) en el carrito</span>
                            <form asp-action="Vaciar" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" style="font-size:.8rem"
                                        onclick="return confirm('¿Vaciar todo el carrito?')">
                                    <i class="bi bi-trash3"></i> Vaciar
                                </button>
                            </form>
                        </div>
                        <div class="table-responsive">
                            <table class="hf-table">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Precio</th>
                                        <th style="width:160px">Cantidad</th>
                                        <th>Subtotal</th>
                                        <th style="width:60px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong style="font-size:.92rem">@item.Nombre</strong>
                                                <br />
                                                <small style="color:var(--text-soft);font-size:.78rem">
                                                    @(item.CategoriaNombre ?? "General") · @(item.UnidadMedida ?? "Unidad")
                                                </small>
                                            </td>
                                            <td style="white-space:nowrap">$@item.Precio.ToString("F2")</td>
                                            <td>
                                                <form asp-action="Actualizar" method="post" class="d-flex align-items-center gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                    <button type="submit" name="cantidad" value="@(item.Cantidad - 1)"
                                                            class="btn btn-sm btn-outline-secondary rounded-3"
                                                            style="width:32px;height:32px;padding:0;font-size:.9rem"
                                                            @(item.Cantidad <= 1 ? "disabled" : "")>
                                                        <i class="bi bi-dash"></i>
                                                    </button>
                                                    <span style="min-width:28px;text-align:center;font-weight:700;font-size:.95rem">@item.Cantidad</span>
                                                    <button type="submit" name="cantidad" value="@(item.Cantidad + 1)"
                                                            class="btn btn-sm btn-outline-secondary rounded-3"
                                                            style="width:32px;height:32px;padding:0;font-size:.9rem"
                                                            @(item.Cantidad >= item.StockDisponible ? "disabled" : "")>
                                                        <i class="bi bi-plus"></i>
                                                    </button>
                                                    <small style="color:var(--text-soft);font-size:.72rem;margin-left:4px">Stock: @item.StockDisponible</small>
                                                </form>
                                            </td>
                                            <td style="font-weight:700;color:var(--primary);white-space:nowrap">$@item.Subtotal.ToString("F2")</td>
                                            <td>
                                                <form asp-action="Eliminar" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productoId" value="@item.ProductoId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3"
                                                            style="width:32px;height:32px;padding:0"
                                                            title="Eliminar">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Resumen -->
                <div class="col-lg-4">
                    <div class="hf-card" style="position:sticky;top:90px">
                        <div class="hf-card-header"><i class="bi bi-receipt me-2"></i>Resumen del pedido</div>
                        <div style="padding:20px">
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color:var(--text-soft);font-size:.9rem">Productos (@Model.Sum(i => i.Cantidad))</span>
                                <span style="font-weight:600">$@total.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span style="color:var(--text-soft);font-size:.9rem">Envio</span>
                                <span style="font-weight:600;color:var(--primary)">Gratis</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between mb-4">
                                <strong style="font-size:1.1rem">Total</strong>
                                <strong style="font-size:1.3rem;color:var(--primary)">$@total.ToString("F2")</strong>
                            </div>

                            <form asp-action="Pagar" method="post" id="formPagoCarrito">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="metodoPago" id="metodoPagoCarrito" value="" />

                                <!-- Opción 1: Pagar con PayPhone (Solid Blue) -->
                                <button type="submit" onclick="document.getElementById('metodoPagoCarrito').value='PayPhone'"
                                        class="btn text-white w-100 mb-2"
                                        style="background-color: #2563eb; border: none; font-weight: 600; padding: 12px; border-radius: 8px; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background-color 0.2s;">
                                    <i class="bi bi-smartphone" style="font-size: 1.1rem;"></i>
                                    Pagar con PayPhone
                                </button>

                                <!-- Opción 2: Pagar con PayPal Sandbox (White / Blue border) -->
                                <button type="submit" onclick="document.getElementById('metodoPagoCarrito').value='PayPal'"
                                        class="btn w-100 mb-2"
                                        style="background-color: #ffffff; border: 1.5px solid #3b82f6; color: #2563eb; font-weight: 600; padding: 12px; border-radius: 8px; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background-color 0.2s;">
                                    <i class="bi bi-paypal" style="font-size: 1.1rem;"></i>
                                    Pagar con PayPal Sandbox
                                </button>

                                <!-- Opción 3: Botón PayPal / Tarjeta (White / Gray border) -->
                                <button type="button" id="btn-toggle-paypal-cart"
                                        class="btn w-100 mb-3"
                                        style="background-color: #ffffff; border: 1.5px solid #d1d5db; color: #374151; font-weight: 600; padding: 12px; border-radius: 8px; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; transition: background-color 0.2s;">
                                    <i class="bi bi-credit-card" style="font-size: 1.1rem;"></i>
                                    Botón PayPal / Tarjeta
                                </button>
                            </form>

                            <!-- Alertas de Estado/Errores en el Carrito -->
                            <div id="payment-cart-alert" class="alert alert-danger d-none mb-3" role="alert" style="border-radius: 8px; font-size: 0.85rem; padding: 8px 12px;">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <span id="payment-cart-alert-msg"></span>
                            </div>

                            <!-- Contenedor del Widget Inteligente (Oculto) -->
                            <div id="paypal-cart-widget-wrapper" class="d-none mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px;">
                                <div id="paypal-button-container"></div>
                            </div>

                            <!-- Footer de Seguridad -->
                            <div class="text-center mt-3 mb-2" style="color: #94a3b8; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 6px;">
                                <i class="bi bi-shield-check" style="font-size: 1.1rem; color: #94a3b8;"></i>
                                <span>Ambiente de pruebas — no se realizan cargos reales</span>
                            </div>

                            <a asp-controller="Tienda" asp-action="Index" class="btn-outline-hf w-100 justify-content-center mt-2" style="font-size:.85rem;padding:10px;">
                                <i class="bi bi-arrow-left"></i> Seguir comprando
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Overlay y Spinner de Procesamiento de Pago -->
<div id="loading-overlay" class="d-none" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(5px); z-index: 9999; display: flex; align-items: center; justify-content: center; flex-direction: column; color: white;">
    <div class="spinner-border text-success" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 5px; margin-bottom: 20px;">
        <span class="visually-hidden">Cargando...</span>
    </div>
    <h4 style="font-weight: 700; letter-spacing: 0.5px;">Procesando y Capturando el Pago...</h4>
    <p class="text-white-50" style="font-size: 0.95rem;">Por favor, no recargues ni cierres la página.</p>
</div>

<script>
    let buttonsInitialized = false;

    function initPayPalButtons() {
        if (buttonsInitialized) return;
        buttonsInitialized = true;

        paypal.Buttons({
            createOrder: function (data, actions) {
                const alertDiv = document.getElementById('payment-cart-alert');
                alertDiv.classList.add('d-none');

                // Hacer petición AJAX para crear la venta y la orden de PayPal
                return fetch('@Url.Action("CrearPagoBotonJson", "Carrito")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Error al iniciar orden en el servidor");
                    }
                    return response.json();
                })
                .then(result => {
                    if (result.success && result.paypalOrderId) {
                        // Guardar pagoId globalmente para usarlo en onApprove
                        window.currentPagoId = result.pagoId;
                        return result.paypalOrderId;
                    } else {
                        throw new Error(result.message || "Error al crear la orden de PayPal.");
                    }
                })
                .catch(error => {
                    alertDiv.classList.remove('d-none');
                    document.getElementById('payment-cart-alert-msg').innerText = error.message;
                    buttonsInitialized = false;
                    throw error;
                });
            },
            onApprove: function (data, actions) {
                // Mostrar overlay de carga
                const overlay = document.getElementById('loading-overlay');
                overlay.classList.remove('d-none');
                overlay.style.display = 'flex';

                const alertDiv = document.getElementById('payment-cart-alert');
                alertDiv.classList.add('d-none');

                // Capturar el pago en el backend
                fetch('@Url.Action("CapturePayPalButtonOrderJson", "Payment")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        PayPalOrderId: data.orderID,
                        PagoId: window.currentPagoId
                    })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Error en la respuesta del servidor");
                    }
                    return response.json();
                })
                .then(result => {
                    if (result.success && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                    } else {
                        overlay.classList.add('d-none');
                        overlay.style.display = 'none';
                        document.getElementById('payment-cart-alert-msg').innerText = result.message || "No se pudo completar el pago.";
                        alertDiv.classList.remove('d-none');
                    }
                })
                .catch(error => {
                    overlay.classList.add('d-none');
                    overlay.style.display = 'none';
                    document.getElementById('payment-cart-alert-msg').innerText = "Ocurrió un problema de red al procesar el pago.";
                    alertDiv.classList.remove('d-none');
                    console.error("Error:", error);
                });
            },
            onCancel: function (data) {
                if (window.currentPagoId) {
                    window.location.href = '@Url.Action("Cancel", "Payment")?token=' + data.orderID;
                }
            },
            onError: function (err) {
                const alertDiv = document.getElementById('payment-cart-alert');
                document.getElementById('payment-cart-alert-msg').innerText = "Error con PayPal. Por favor, reintente.";
                alertDiv.classList.remove('d-none');
                console.error("PayPal Error:", err);
            }
        }).render('#paypal-button-container');
    }

    document.getElementById('btn-toggle-paypal-cart').addEventListener('click', function() {
        const wrapper = document.getElementById('paypal-cart-widget-wrapper');
        if (wrapper.classList.contains('d-none')) {
            wrapper.classList.remove('d-none');
            initPayPalButtons();
            wrapper.scrollIntoView({ behavior: 'smooth' });
        } else {
            wrapper.classList.add('d-none');
        }
    });
</script>
