@model HuellitasFelices.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div style="background:var(--gray-50); min-height:calc(100vh - 120px); display:flex; align-items:center; padding:40px 16px">
    <div style="width:100%; max-width:440px; margin:0 auto">
        <div class="login-card">
            <div class="login-card-header">
                <div style="width:56px;height:56px;background:rgba(255,255,255,.2);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
                    <i class="bi bi-key-fill" style="font-size:1.6rem; color:white"></i>
                </div>
                <h4>¿Olvidaste tu contraseña?</h4>
                <p>Ingresa tu correo para recuperarla</p>
            </div>
            <div class="card-body" style="padding: 28px 32px 32px;">
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo electrónico</label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    <button type="submit" class="btn-primary-hf w-100 justify-content-center" style="padding:13px; display:inline-flex; align-items:center; gap:8px">
                        <i class="bi bi-send-fill"></i> Enviar enlace de recuperación
                    </button>
                </form>
            </div>
            <div style="padding:16px 32px 24px; text-align:center; border-top:1px solid var(--border)">
                <a asp-action="Login" class="btn-outline-hf" style="padding:7px 16px; font-size:.88rem; text-decoration:none; display:inline-flex; align-items:center; gap:6px">
                    <i class="bi bi-arrow-left"></i> Volver al Inicio de Sesión
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
