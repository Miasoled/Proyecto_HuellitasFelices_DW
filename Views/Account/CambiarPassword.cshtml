@model HuellitasFelices.Areas.Identity.Pages.Account.CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-key me-2"></i>Cambiar contraseña</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="hf-card">
                <div class="hf-card-header">
                    <i class="bi bi-shield-lock me-2"></i>Actualizar contraseña
                </div>
                <div style="padding:24px">

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Mensaje"]
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <form asp-action="CambiarPassword" method="post">
                        <div class="mb-3">
                            <label asp-for="PasswordActual" class="form-label"></label>
                            <input asp-for="PasswordActual" class="form-control" />
                            <span asp-validation-for="PasswordActual" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NuevaPassword" class="form-label"></label>
                            <input asp-for="NuevaPassword" class="form-control" />
                            <span asp-validation-for="NuevaPassword" class="text-danger" style="font-size:.82rem"></span>
                            <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y un número.</div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmarPassword" class="form-label"></label>
                            <input asp-for="ConfirmarPassword" class="form-control" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn-primary-hf justify-content-center flex-fill">
                                <i class="bi bi-check-lg"></i> Guardar contraseña
                            </button>
                            <a asp-action="MiPanel" class="btn-outline-hf justify-content-center">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div></div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
