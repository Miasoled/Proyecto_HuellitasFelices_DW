@{
    ViewData["Title"] = "Mi panel";
    var dueno    = ViewBag.Dueno    as HuellitasFelices.Models.Dueno;
    var mascotas = ViewBag.Mascotas as List<HuellitasFelices.Models.Mascota>          ?? new();
    var consultas= ViewBag.Consultas as List<HuellitasFelices.Models.Consulta>        ?? new();
    var consultasPendientesPago = ViewBag.ConsultasPendientesPago as List<HuellitasFelices.Models.Consulta> ?? new();
    var solicitudes= ViewBag.Solicitudes as List<HuellitasFelices.Models.SolicitudAdopcion> ?? new();
    var productos   = ViewBag.ProductosDestacados as List<HuellitasFelices.Models.Producto> ?? new();
}

<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-grid-1x2-fill me-2"></i>Mi panel</h1>
                <small style="opacity:.8">Bienvenido, <strong>@dueno?.Nombre</strong></small>
            </div>
            <a asp-controller="Consultas" asp-action="Create" class="btn-hero-primary">
                <i class="bi bi-calendar-plus-fill"></i> Agendar cita
            </a>
        </div>
    </div>
</div>

<div class="content-wrapper"><div class="container">

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-item">
                <div class="stat-icon" style="background:#dcfce7"><i class="bi bi-patch-heart-fill text-success fs-4"></i></div>
                <h3 class="text-success">@mascotas.Count</h3>
                <p>Mis mascotas</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-item">
                <div class="stat-icon" style="background:#dbeafe"><i class="bi bi-clipboard2-pulse-fill text-primary fs-4"></i></div>
                <h3 class="text-primary">@consultas.Count</h3>
                <p>Consultas</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-item">
                <div class="stat-icon" style="background:#fef9c3"><i class="bi bi-file-earmark-check-fill text-warning fs-4"></i></div>
                <h3 class="text-warning">@solicitudes.Count</h3>
                <p>Solicitudes</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-item">
                <div class="stat-icon" style="background:#ede9fe"><i class="bi bi-bag-heart-fill fs-4" style="color:#7c3aed"></i></div>
                <h3 style="color:#7c3aed">@productos.Count</h3>
                <p>Productos</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Mascotas -->
        <div class="col-lg-7">
            <div class="hf-card">
                <div class="hf-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-patch-heart-fill me-2"></i>Mis mascotas</span>
                    <a asp-controller="Mascotas" asp-action="Create" class="btn-hero-primary" style="padding:6px 14px; font-size:.82rem">
                        <i class="bi bi-plus-lg"></i> Agregar
                    </a>
                </div>
                @if (mascotas.Count == 0)
                {
                    <div style="padding:32px; text-align:center; color:var(--text-soft)">
                        <i class="bi bi-patch-heart" style="font-size:2.5rem; opacity:.3; display:block; margin-bottom:12px"></i>
                        No tienes mascotas registradas aún.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="hf-table">
                            <thead><tr><th>Nombre</th><th>Especie</th><th>Raza</th><th>Edad</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var m in mascotas)
                                {
                                    <tr>
                                        <td><strong>@m.Nombre</strong></td>
                                        <td><span class="badge-@(m.Especie=="Perro"?"success":"info")-hf">@m.Especie</span></td>
                                        <td style="font-size:.88rem">@m.Raza</td>
                                        <td style="font-size:.88rem">@m.Edad años</td>
                                        <td>
                                            <a asp-controller="Mascotas" asp-action="Details" asp-route-id="@m.Id" class="btn-action btn-view">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Acciones rápidas -->
        <div class="col-lg-5">
            <div class="hf-card mb-4">
                <div class="hf-card-header"><i class="bi bi-lightning-charge-fill me-2"></i>Acciones rápidas</div>
                <div style="padding:16px; display:flex; flex-direction:column; gap:10px">
                    <a asp-controller="Consultas" asp-action="Create" class="btn-primary-hf justify-content-start">
                        <i class="bi bi-calendar-plus"></i> Agendar consulta veterinaria
                    </a>
                    <a asp-controller="AnimalesAdopcion" asp-action="Index" class="btn-outline-hf justify-content-start">
                        <i class="bi bi-house-heart"></i> Ver animales en adopción
                    </a>
                    <a asp-controller="SolicitudesAdopcion" asp-action="Create" class="btn-outline-hf justify-content-start">
                        <i class="bi bi-file-earmark-plus"></i> Solicitar adopción
                    </a>
                    <a asp-controller="Mascotas" asp-action="Create" class="btn-outline-hf justify-content-start">
                        <i class="bi bi-plus-circle"></i> Registrar nueva mascota
                    </a>
                    <a asp-controller="Tienda" asp-action="Index" class="btn-outline-hf justify-content-start">
                        <i class="bi bi-bag-heart"></i> Ir a la tienda
                    </a>
                    <hr style="margin:4px 0; border-color:var(--border)">
                    <a asp-controller="Account" asp-action="CambiarPassword" class="btn-outline-hf justify-content-start">
                        <i class="bi bi-key"></i> Cambiar contraseña
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Consultas pendientes de pago -->
    @if (consultasPendientesPago.Count > 0)
    {
        <div class="hf-card mt-4" style="border: 2px solid #f59e0b;">
            <div class="hf-card-header" style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Consultas pendientes de pago — Tienes medicamentos recetados
            </div>
            @foreach (var c in consultasPendientesPago)
            {
                var totalMed = c.Medicamentos?.Sum(m => m.Subtotal) ?? 0;
                var totalGeneral = c.Costo + totalMed;
                <div class="p-3 border-bottom" style="border-color: var(--border) !important;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong><i class="bi bi-patch-heart me-1"></i>@c.Mascota?.Nombre</strong>
                            <span class="text-muted ms-2" style="font-size:.82rem">@c.Motivo</span>
                        </div>
                        <span class="badge bg-warning text-dark">Pendiente de pago</span>
                    </div>
                    <div style="font-size:.85rem; color: var(--text-soft);">
                        <i class="bi bi-clipboard2-check me-1"></i>Diagnostico: @(c.Diagnostico ?? "Sin diagnostico")
                    </div>
                    @if (c.Medicamentos != null && c.Medicamentos.Any())
                    {
                        <div class="mt-2" style="font-size:.85rem;">
                            <strong><i class="bi bi-capsule me-1"></i>Medicamentos:</strong>
                            <ul class="mb-2 mt-1" style="padding-left: 20px;">
                                @foreach (var med in c.Medicamentos)
                                {
                                    <li>@med.Producto?.Nombre x @med.Cantidad — $@med.Subtotal.ToString("F2")
                                        @if (!string.IsNullOrEmpty(med.Dosis)) { <span class="text-muted">(@med.Dosis)</span> }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="border-color: var(--border) !important;">
                        <div style="font-size:.9rem;">
                            Consulta: <strong>$@c.Costo.ToString("F2")</strong>
                            @if (totalMed > 0) { <span class="ms-2">Medicamentos: <strong>$@totalMed.ToString("F2")</strong></span> }
                            <span class="ms-2 fw-bold" style="color: var(--primary);">Total: $@totalGeneral.ToString("F2")</span>
                        </div>
                        <a asp-controller="Ventas" asp-action="Pagar" asp-route-consultaId="@c.Id" class="btn-primary-hf" style="padding:8px 18px; font-size:.85rem;">
                            <i class="bi bi-credit-card me-1"></i>Proceder al pago
                        </a>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Últimas consultas -->
    @if (consultas.Count > 0)
    {
        <div class="hf-card mt-4">
            <div class="hf-card-header"><i class="bi bi-clipboard2-pulse-fill me-2"></i>Últimas consultas</div>
            <div class="table-responsive">
                <table class="hf-table">
                    <thead><tr><th>Motivo</th><th>Estado</th><th>Fecha</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in consultas)
                        {
                             var badgeClass = c.Estado switch {
                                 "Pendiente"   => "badge-warning-hf",
                                 "EnRevision"  => "badge-info-hf",
                                 "Completada"  => "badge-success-hf",
                                 _             => "badge-warning-hf"
                             };
                            <tr>
                                <td><strong style="font-size:.9rem">@c.Motivo</strong></td>
                                <td><span class="@badgeClass" style="font-size:.78rem">@c.Estado</span></td>
                                <td style="font-size:.85rem; color:var(--text-soft)">@c.FechaConsulta.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-controller="Consultas" asp-action="Details" asp-route-id="@c.Id" class="btn-action btn-view">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Tienda destacados -->
    @if (productos.Count > 0)
    {
        <div class="hf-card mt-4">
            <div class="hf-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bag-heart-fill me-2"></i>Tienda — Productos destacados</span>
                <a asp-controller="Tienda" asp-action="Index" class="btn-hero-primary" style="padding:6px 14px;font-size:.82rem">
                    <i class="bi bi-grid-3x3-gap"></i> Ver todo
                </a>
            </div>
            <div style="padding:16px">
                <div class="row g-3">
                    @foreach (var item in productos)
                    {
                        var stock = item.Inventarios?.Sum(i => i.StockActual) ?? 0;
                        var catIcon = item.Categoria?.Nombre?.ToLower() switch {
                            "alimento" => "bi-cup-hot-fill",
                            "medicamento" => "bi-capsule",
                            "accesorio" => "bi-handbag-fill",
                            "higiene" => "bi-droplet-fill",
                            _ => "bi-box-seam"
                        };
                        var catColor = item.Categoria?.Nombre?.ToLower() switch {
                            "alimento" => "#16a34a",
                            "medicamento" => "#2563eb",
                            "accesorio" => "#d97706",
                            "higiene" => "#7c3aed",
                            _ => "#6b7280"
                        };

                        <div class="col-6 col-md-4">
                            <div style="background:var(--gray-50);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center;transition:transform .2s,box-shadow .2s;height:100%;display:flex;flex-direction:column;align-items:center"
                                 onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,.1)'"
                                 onmouseout="this.style.transform='';this.style.boxShadow=''">
                                <div style="width:52px;height:52px;background:@(catColor)15;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:10px">
                                    <i class="bi @catIcon" style="font-size:1.4rem;color:@catColor"></i>
                                </div>
                                <h6 style="font-weight:700;font-size:.88rem;margin:0 0 4px;line-height:1.2">@item.Nombre</h6>
                                <small style="color:var(--text-soft);font-size:.75rem;margin-bottom:8px">@(item.Categoria?.Nombre ?? "General")</small>
                                <div style="font-weight:800;color:var(--primary);font-size:1.1rem;margin-top:auto">$@item.PrecioVenta.ToString("F2")</div>
                                <a asp-controller="Tienda" asp-action="Detalle" asp-route-id="@item.Id" class="btn-outline-hf mt-2" style="padding:5px 12px;font-size:.78rem">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div></div>
