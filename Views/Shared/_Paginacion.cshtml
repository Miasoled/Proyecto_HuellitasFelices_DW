@using HuellitasFelices.Models
@using Microsoft.AspNetCore.WebUtilities
@model PaginacionViewModel

@functions {
    string UrlPagina(int pagina)
    {
        var parametros = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "pagina", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(q => q.Key, q => (string?)q.Value.ToString());
        parametros["pagina"] = pagina.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path, parametros);
    }
}

@if (Model != null && Model.TotalPaginas > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
        <small class="text-muted">
            <i class="bi bi-table me-1"></i>
            Mostrando página <strong>@Model.PaginaActual</strong> de <strong>@Model.TotalPaginas</strong>
            &mdash; <strong>@Model.TotalRegistros.ToString("N0")</strong> registros en total
        </small>
        <nav>
            <ul class="pagination pagination-sm mb-0 gap-1">
                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" href="@UrlPagina(1)" aria-label="Primera página">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                    <a class="page-link" href="@UrlPagina(Model.PaginaActual - 1)" aria-label="Página anterior">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int i = Math.Max(1, Model.PaginaActual - 2); i <= Math.Min(Model.TotalPaginas, Model.PaginaActual + 2); i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" href="@UrlPagina(i)">@i</a>
                    </li>
                }

                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" href="@UrlPagina(Model.PaginaActual + 1)" aria-label="Página siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                    <a class="page-link" href="@UrlPagina(Model.TotalPaginas)" aria-label="Última página">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
