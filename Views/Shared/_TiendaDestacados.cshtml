@model IEnumerable<HuellitasFelices.Models.Producto>

@if (Model.Any())
{
    <div class="hf-card">
        <div class="hf-card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-bag-heart-fill me-2"></i>Tienda — Productos destacados</span>
            <a asp-controller="Tienda" asp-action="Index" class="btn-hero-primary" style="padding:6px 14px;font-size:.82rem">
                <i class="bi bi-grid-3x3-gap"></i> Ver todo
            </a>
        </div>
        <div style="padding:16px">
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    var stock = item.Inventarios?.Sum(i => i.StockActual) ?? 0;
                    var disponible = stock > 0;
                    var catIcon = item.Categoria?.Nombre?.ToLower() switch {
                        "alimento" => "bi-cup-hot-fill",
                        "medicamento" => "bi-capsule",
                        "accesorio" => "bi-handbag-fill",
                        "higiene" => "bi-droplet-fill",
                        _ => "bi-box-seam"
                    };
                    var catColor = item.Categoria?.Nombre?.ToLower() switch {
                        "alimento" => "#00BCE1",
                        "medicamento" => "#2563eb",
                        "accesorio" => "#d97706",
                        "higiene" => "#7c3aed",
                        _ => "#6b7280"
                    };

                    <div class="col-6 col-md-4">
                        <div style="background:var(--gray-50);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center;transition:transform .2s,box-shadow .2s;height:100%;display:flex;flex-direction:column;align-items:center"
                             onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,.1)'"
                             onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div style="width:52px;height:52px;background:@(catColor)15;border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:10px">
                                <i class="bi @catIcon" style="font-size:1.4rem;color:@catColor"></i>
                            </div>
                            <h6 style="font-weight:700;font-size:.88rem;margin:0 0 4px;line-height:1.2">@item.Nombre</h6>
                            <small style="color:var(--text-soft);font-size:.75rem;margin-bottom:8px">@(item.Categoria?.Nombre ?? "General")</small>
                            <div style="font-weight:800;color:var(--primary);font-size:1.1rem;margin-top:auto">$@item.PrecioVenta.ToString("F2")</div>
                            <a asp-controller="Tienda" asp-action="Detalle" asp-route-id="@item.Id" class="btn-outline-hf mt-2" style="padding:5px 12px;font-size:.78rem">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
