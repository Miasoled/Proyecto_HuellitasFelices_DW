@model HuellitasFelices.Models.Producto
@{
    ViewData["Title"] = "Detalle Producto";
    var inventarios = ViewBag.Inventarios as List<HuellitasFelices.Models.Inventario> ?? new();
    var stockTotal = ViewBag.StockTotal as int? ?? 0;
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventario</a></li>
            <li class="breadcrumb-item active">Detalle</li>
        </ol></nav>
        <h1><i class="bi bi-eye me-2"></i>@Model.Nombre</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="hf-card h-100">
                <h5 class="mb-3">Información General</h5>
                <dl class="row mb-0">
                    <dt class="col-sm-5">Código de barras</dt>
                    <dd class="col-sm-7"><code>@(Model.CodigoBarras ?? "—")</code></dd>
                    <dt class="col-sm-5">Categoría</dt>
                    <dd class="col-sm-7">@Model.Categoria?.Nombre</dd>
                    <dt class="col-sm-5">Proveedor</dt>
                    <dd class="col-sm-7">@(Model.Proveedor?.Nombre ?? "—")</dd>
                    <dt class="col-sm-5">Unidad de medida</dt>
                    <dd class="col-sm-7">@(Model.UnidadMedida ?? "—")</dd>
                    <dt class="col-sm-5">Descripción</dt>
                    <dd class="col-sm-7">@(Model.Descripcion ?? "—")</dd>
                    <dt class="col-sm-5">Stock mínimo</dt>
                    <dd class="col-sm-7">@Model.StockMinimo</dd>
                    <dt class="col-sm-5">Precio compra</dt>
                    <dd class="col-sm-7">$@Model.PrecioCompra.ToString("N2")</dd>
                    <dt class="col-sm-5">Precio venta</dt>
                    <dd class="col-sm-7">$@Model.PrecioVenta.ToString("N2")</dd>
                    <dt class="col-sm-5">Creado</dt>
                    <dd class="col-sm-7">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="hf-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Stock por Sucursal</h5>
                    <span class="badge bg-success fs-6">Total: @stockTotal</span>
                </div>
                @if (inventarios.Any())
                {
                    <table class="hf-table">
                        <thead><tr><th>Sucursal</th><th class="text-end">Stock</th></tr></thead>
                        <tbody>
                            @foreach (var inv in inventarios.OrderByDescending(i => i.StockActual))
                            {
                                <tr>
                                    <td>@inv.Sucursal?.Nombre</td>
                                    <td class="text-end">
                                        <span class="@(inv.StockActual <= Model.StockMinimo ? "text-danger fw-bold" : "")">
                                            @inv.StockActual
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">Sin registros de inventario.</p>
                }
            </div>
        </div>
    </div>
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-search"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn-back">Volver</a>
    </div>
</div></div>
