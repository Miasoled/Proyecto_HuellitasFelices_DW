@model HuellitasFelices.Models.Producto
@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventario</a></li>
            <li class="breadcrumb-item active">Eliminar</li>
        </ol></nav>
        <h1><i class="bi bi-trash me-2"></i>Eliminar Producto</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="hf-card" style="max-width:600px">
        <div class="text-center mb-4">
            <div style="width:64px;height:64px;background:#fef2f2;border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 16px">
                <i class="bi bi-exclamation-triangle" style="font-size:1.8rem;color:#dc2626"></i>
            </div>
            <h5 style="font-weight:700">¿Estás seguro de eliminar este producto?</h5>
            <p style="color:var(--text-soft);font-size:.9rem">Esta acción ocultará el producto del sistema y la tienda.</p>
        </div>

        <div style="background:var(--gray-50);border:1px solid var(--border);border-radius:12px;padding:20px">
            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
                <dt class="col-sm-4">Categoría</dt>
                <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "—")</dd>
                <dt class="col-sm-4">Proveedor</dt>
                <dd class="col-sm-8">@(Model.Proveedor?.Nombre ?? "—")</dd>
                <dt class="col-sm-4">Precio venta</dt>
                <dd class="col-sm-8">$@Model.PrecioVenta.ToString("N2")</dd>
                <dt class="col-sm-4">Stock mínimo</dt>
                <dd class="col-sm-8">@Model.StockMinimo</dd>
                <dt class="col-sm-4">Código barras</dt>
                <dd class="col-sm-8"><code>@(Model.CodigoBarras ?? "—")</code></dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2 justify-content-center">
                <button type="submit" class="btn" style="background:#dc2626;color:white;padding:10px 28px;border-radius:10px;font-weight:700">
                    <i class="bi bi-trash me-1"></i> Sí, eliminar
                </button>
                <a asp-action="Index" class="btn-back">Cancelar</a>
            </div>
        </form>
    </div>
</div></div>
