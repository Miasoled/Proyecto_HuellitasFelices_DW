@model HuellitasFelices.Models.Producto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventario</a></li>
            <li class="breadcrumb-item active">Nuevo producto</li>
        </ol></nav>
        <h1><i class="bi bi-plus-lg me-2"></i>Nuevo Producto</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="hf-card" style="max-width:700px">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CodigoBarras" class="form-label"></label>
                    <input asp-for="CodigoBarras" class="form-control" />
                    <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="ImagenUrl" class="form-label"></label>
                    <input asp-for="ImagenUrl" type="url" class="form-control" placeholder="https://ejemplo.com/producto.jpg" />
                    <div class="form-text">Pega la URL directa de la imagen (.jpg, .png o .webp). Se guardará en la base de datos.</div>
                    <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PrecioCompra" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioCompra" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="PrecioCompra" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PrecioVenta" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StockMinimo" class="form-label"></label>
                    <input asp-for="StockMinimo" class="form-control" type="number" />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoriaId" class="form-label">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProveedorId" class="form-label">Proveedor</label>
                    <select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.ProveedorId">
                        <option value="">— Sin proveedor —</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="UnidadMedida" class="form-label"></label>
                    <select asp-for="UnidadMedida" class="form-select">
                        <option value="Unidad">Unidad</option>
                        <option value="Kg">Kilogramo</option>
                        <option value="Litro">Litro</option>
                        <option value="Paquete">Paquete</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Sucursal</label>
                    <select name="SucursalId" class="form-select" asp-items="ViewBag.SucursalId">
                        <option value="">— Seleccione sucursal —</option>
                    </select>
                </div>
            </div>
            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn-search"><i class="bi bi-check-lg"></i> Guardar</button>
                <a asp-action="Index" class="btn-back">Cancelar</a>
            </div>
        </form>
    </div>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
