@{ ViewData["Title"] = "Transferir Stock"; }

<section class="container py-4">
    <h2><i class="bi bi-arrow-left-right"></i> Transferir Stock entre Sucursales</h2>
    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Transferir" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label for="productoId" class="form-label">Producto</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="search"
                                       id="buscarProducto"
                                       class="form-control"
                                       placeholder="Buscar producto por nombre..."
                                       autocomplete="off"
                                       aria-describedby="resultadoBusquedaProducto" />
                                <button type="button" id="limpiarBusquedaProducto" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            @Html.DropDownList("productoId", (SelectList)ViewBag.ProductoId, "-- Seleccione producto --", new { @class = "form-select" })
                            <div id="resultadoBusquedaProducto" class="form-text">
                                Escriba para filtrar la lista de productos.
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="sucursalOrigenId" class="form-label">Sucursal Origen</label>
                                @Html.DropDownList("sucursalOrigenId", (SelectList)ViewBag.SucursalOrigenId, "-- Origen --", new { @class = "form-select" })
                            </div>
                            <div class="col-md-6">
                                <label for="sucursalDestinoId" class="form-label">Sucursal Destino</label>
                                @Html.DropDownList("sucursalDestinoId", (SelectList)ViewBag.SucursalDestinoId, "-- Destino --", new { @class = "form-select" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="cantidad" class="form-label">Cantidad</label>
                            <input type="number" name="cantidad" id="cantidad" class="form-control" min="1" value="1" required />
                        </div>

                        <div class="mb-3">
                            <label for="observacion" class="form-label">Observación (opcional)</label>
                            <textarea name="observacion" id="observacion" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-arrow-left-right"></i> Transferir
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buscador = document.getElementById("buscarProducto");
            const selector = document.getElementById("productoId");
            const limpiar = document.getElementById("limpiarBusquedaProducto");
            const resultado = document.getElementById("resultadoBusquedaProducto");

            if (!buscador || !selector || !limpiar || !resultado) return;

            const productos = Array.from(selector.options)
                .filter(option => option.value)
                .map(option => ({
                    value: option.value,
                    text: option.text,
                    selected: option.selected
                }));

            function normalizar(texto) {
                return texto
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .toLowerCase()
                    .trim();
            }

            function filtrarProductos() {
                const busqueda = normalizar(buscador.value);
                const valorSeleccionado = selector.value;
                const coincidencias = productos.filter(producto =>
                    normalizar(producto.text).includes(busqueda));

                selector.replaceChildren();
                selector.add(new Option("-- Seleccione producto --", ""));

                coincidencias.forEach(producto => {
                    const option = new Option(producto.text, producto.value);
                    option.selected = producto.value === valorSeleccionado;
                    selector.add(option);
                });

                if (coincidencias.length === 1 && busqueda) {
                    selector.value = coincidencias[0].value;
                }

                resultado.textContent = busqueda
                    ? `${coincidencias.length} producto(s) encontrado(s).`
                    : "Escriba para filtrar la lista de productos.";
            }

            buscador.addEventListener("input", filtrarProductos);
            limpiar.addEventListener("click", function () {
                buscador.value = "";
                filtrarProductos();
                buscador.focus();
            });
        });
    </script>
}
