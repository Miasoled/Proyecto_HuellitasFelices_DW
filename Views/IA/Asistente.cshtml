@{
    ViewData["Title"] = "Asistente IA";
}

<div class="page-header"><div class="container">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active">Asistente IA</li>
    </ol></nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1><i class="bi bi-robot me-2"></i>Asistente Veterinario IA</h1>
            <small style="opacity:.8">Powered by Ollama &middot; @ViewBag.ModelName</small>
        </div>
        <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>En linea</span>
    </div>
</div></div>

<div class="content-wrapper"><div class="container">
<div class="row justify-content-center"><div class="col-lg-8">

    <!-- Chat container -->
    <div class="hf-card">
        <div class="hf-card-header">
            <i class="bi bi-chat-dots me-2"></i>Chat con el asistente
        </div>
        <div class="card-body p-0">
            <!-- Mensajes -->
            <div id="chat-messages" style="height: 420px; overflow-y: auto; padding: 20px;">
                <div class="chat-msg chat-bot mb-3">
                    <div class="d-flex align-items-start gap-2">
                        <div style="width:36px;height:36px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                            <i class="bi bi-robot text-white" style="font-size:.9rem"></i>
                        </div>
                        <div style="background:var(--bg-secondary);border:1px solid var(--border);border-radius:12px;padding:12px 16px;max-width:85%">
                            <p class="mb-1" style="font-size:.9rem">Hola! Soy el asistente inteligente de <strong>Huellitas Felices</strong>.</p>
                            <p class="mb-0" style="font-size:.85rem;color:var(--text-soft)">Puedo responder preguntas sobre la clinica: clientes, mascotas, consultas, ventas, inventario, y mas. Intenta preguntar algo como:</p>
                            <div class="mt-2 d-flex flex-wrap gap-1">
                                <button class="btn btn-sm btn-outline-primary rounded-pill suggestion-btn" onclick="enviarSugerencia(this)">Cuantos clientes tenemos?</button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill suggestion-btn" onclick="enviarSugerencia(this)">Que mascotas hay registradas?</button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill suggestion-btn" onclick="enviarSugerencia(this)">Cuantas consultas hay hoy?</button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill suggestion-btn" onclick="enviarSugerencia(this)">Hay productos con bajo stock?</button>
                                <button class="btn btn-sm btn-outline-primary rounded-pill suggestion-btn" onclick="enviarSugerencia(this)">Cuanto hemos vendido este mes?</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Input -->
            <div class="p-3 border-top" style="border-color: var(--border) !important;">
                <form id="chat-form" class="d-flex gap-2">
                    <input type="text" id="chat-input" class="form-control" placeholder="Escribe tu pregunta sobre la clinica..." autocomplete="off" />
                    <button type="submit" id="btn-enviar" class="btn-primary-hf" style="padding:10px 20px; white-space:nowrap;">
                        <i class="bi bi-send"></i> Enviar
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Info card -->
    <div class="hf-card mt-3">
        <div class="card-body p-3" style="font-size:.82rem; color:var(--text-soft);">
            <i class="bi bi-info-circle me-1"></i>
            Este asistente utiliza inteligencia artificial local (Ollama) para responder preguntas sobre los datos de la clinica.
            Los datos se obtienen en tiempo real de la base de datos. El modelo puede tardar unos segundos en responder.
        </div>
    </div>

</div></div></div></div>

@section Scripts {
    <script src="~/js/ia-chat.js"></script>
}
