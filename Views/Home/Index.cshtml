@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
}

<main class="home-page @(User.Identity?.IsAuthenticated == true ? "home-page-auth" : "")">
<!-- ═══════════ HERO ═══════════ -->
<section class="hero home-hero">
    <div class="container home-hero-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="hero-badge home-hero-badge">
                    <i class="bi bi-patch-check-fill"></i>
                    Clínica veterinaria de confianza
                </div>
                <h1 class="mt-3 mb-3">
                    Cuidamos su salud.<br>
                    <span>Celebramos su vida.</span>
                </h1>
                <p class="home-hero-description">
                    Atención veterinaria cercana y confiable para acompañar cada etapa de la vida de tu mascota.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Consultas" asp-action="Create" class="btn-hf-primary">
                            <i class="bi bi-calendar-plus-fill"></i> Agendar cita
                        </a>
                        <a asp-controller="AnimalesAdopcion" asp-action="Index" class="btn-hf-outline" style="color:white; border-color:rgba(255,255,255,.4)">
                            <i class="bi bi-heart"></i> Ver adopciones
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn-hf-primary">
                            <i class="bi bi-person-plus-fill"></i> Crear cuenta gratis
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn-hf-outline" style="color:white; border-color:rgba(255,255,255,.4)">
                            <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-flex justify-content-center">
                <div class="home-hero-visual">
                    <div class="hero-paw paw-one"><i class="bi bi-heart-fill"></i></div>
                    <img src="~/images/home-hero-dog.png" alt="Perro atendido por Huellitas Felices" />
                    <div class="hero-visual-note">
                        <span class="hero-note-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                        <span><strong>Atención con cariño</strong><small>Para cada etapa de su vida</small></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════ STATS ═══════════ -->
<section class="home-stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="stat-item home-stat-item">
                    <div class="stat-icon" style="background:var(--color-success-bg)">
                        <i class="bi bi-heart-pulse-fill" style="color:var(--color-success); font-size:1.4rem"></i>
                    </div>
                    <h3 style="color:var(--color-success)">@ViewBag.TotalMascotas.ToString("N0")</h3>
                    <p>Mascotas registradas</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item home-stat-item">
                    <div class="stat-icon" style="background:var(--color-accent-lighter)">
                        <i class="bi bi-people-fill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h3 style="color:var(--color-primary)">@ViewBag.TotalDuenos.ToString("N0")</h3>
                    <p>Dueños atendidos</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item home-stat-item">
                    <div class="stat-icon" style="background:var(--color-info-bg)">
                        <i class="bi bi-clipboard2-pulse-fill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h3 style="color:var(--color-primary)">@ViewBag.TotalConsultas.ToString("N0")</h3>
                    <p>Consultas realizadas</p>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item home-stat-item">
                    <div class="stat-icon" style="background:var(--color-warning-bg)">
                        <i class="bi bi-house-heart-fill" style="color:var(--color-warning); font-size:1.4rem"></i>
                    </div>
                    <h3 style="color:var(--color-warning)">@ViewBag.AnimalesAdopcion.ToString("N0")</h3>
                    <p>En adopción</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════ SERVICIOS ═══════════ -->
<section class="section-white home-services-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label"><i class="bi bi-stars"></i> Nuestros servicios</span>
            <h2 class="section-title">Atención veterinaria integral</h2>
            <p class="section-sub">Todo lo que tu mascota necesita en un solo lugar, con profesionales de confianza.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:var(--color-accent-lighter)">
                        <i class="bi bi-clipboard2-pulse-fill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h5>Consultas veterinarias</h5>
                    <p>Diagnóstico y tratamiento por veterinarios especializados con amplia experiencia clínica.</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Consultas" asp-action="Create" class="btn-hf-primary">
                            <i class="bi bi-calendar-plus"></i> Agendar cita
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-hf-outline">
                            <i class="bi bi-box-arrow-in-right"></i> Ingresar
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:var(--color-info-bg)">
                        <i class="bi bi-capsule-pill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h5>Vacunación</h5>
                    <p>Plan de vacunación completo para perros y gatos. Protege la salud de tu mascota cada año.</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Consultas" asp-action="Create" class="btn-hf-outline">
                            <i class="bi bi-calendar-check"></i> Programar
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn-hf-outline">
                            <i class="bi bi-person-plus"></i> Registrarme
                        </a>
                    }
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:var(--color-warning-bg)">
                        <i class="bi bi-capsule" style="color:var(--color-warning); font-size:1.4rem"></i>
                    </div>
                    <h5>Tratamientos</h5>
                    <p>Desparasitación, antibióticos, antiinflamatorios y planes de tratamiento personalizados.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn-hf-outline">
                        <i class="bi bi-info-circle"></i> Ver más
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:#fce7f3">
                        <i class="bi bi-activity" style="color:#db2777; font-size:1.5rem"></i>
                    </div>
                    <h5>Cirugía y emergencias</h5>
                    <p>Servicio de cirugía menor y atención de emergencias durante todo el horario de atención.</p>
                    <a href="#contacto" class="btn-hf-outline">
                        <i class="bi bi-telephone"></i> Contactar
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:var(--color-info-bg)">
                        <i class="bi bi-stars" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h5>Salud dental</h5>
                    <p>Limpieza dental profesional y tratamientos odontológicos especializados para mascotas.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn-hf-outline">
                        <i class="bi bi-calendar-plus"></i> Reservar
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card home-service-card">
                    <div class="sc-icon" style="background:var(--color-success-bg)">
                        <i class="bi bi-house-heart-fill" style="color:var(--color-success); font-size:1.4rem"></i>
                    </div>
                    <h5>Adopciones</h5>
                    <p>Dale un hogar a un animal rescatado. Todos nuestros animales están vacunados y revisados.</p>
                    <a asp-controller="AnimalesAdopcion" asp-action="Index" class="btn-hf-primary">
                        <i class="bi bi-heart"></i> Ver animales
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════ ADOPCION CTA ═══════════ -->
<section class="section-blue home-adoption-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="section-label"><i class="bi bi-house-heart"></i> Programa de adopción</span>
                <h2 class="section-title mt-2">¡Dale un hogar lleno de amor!</h2>
                <p style="color:rgba(255,255,255,.7); margin-top:12px">
                    Tenemos <strong style="color:var(--color-success)">@ViewBag.AnimalesAdopcion animales</strong> esperando
                    una familia. Todos revisados por nuestros veterinarios, vacunados y listos para integrarse a tu hogar.
                </p>
                <div class="row g-3 mt-3">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;background:var(--color-success-bg);border-radius:8px;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-check2 text-success fw-bold"></i>
                            </div>
                            <span style="font-size:.9rem; color:rgba(255,255,255,.85)">Revisados por veterinarios</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;background:var(--color-success-bg);border-radius:8px;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-check2 text-success fw-bold"></i>
                            </div>
                            <span style="font-size:.9rem; color:rgba(255,255,255,.85)">Vacunación al día</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;background:var(--color-success-bg);border-radius:8px;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-check2 text-success fw-bold"></i>
                            </div>
                            <span style="font-size:.9rem; color:rgba(255,255,255,.85)">Acompañamiento post-adopción</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:32px;height:32px;background:var(--color-success-bg);border-radius:8px;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-check2 text-success fw-bold"></i>
                            </div>
                            <span style="font-size:.9rem; color:rgba(255,255,255,.85)">Sin costo de adopción</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <a asp-controller="AnimalesAdopcion" asp-action="Index" class="btn-hf-primary">
                        <i class="bi bi-arrow-right-circle-fill"></i> Ver animales disponibles
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div style="background:white; border-radius:20px; padding:32px; box-shadow:var(--shadow-lg)">
                    <div style="font-size:.85rem; color:var(--color-text-secondary); margin-bottom:16px; font-weight:600; text-transform:uppercase; letter-spacing:.5px">
                        <i class="bi bi-bar-chart-fill" style="color:var(--color-primary)"></i> Estadísticas de adopción
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded-3" style="background:var(--color-accent-lighter)">
                        <i class="bi bi-house-heart-fill" style="color:var(--color-primary); font-size:1.8rem"></i>
                        <div>
                            <div style="font-size:1.5rem; font-weight:800; color:var(--color-primary)">@ViewBag.AnimalesAdopcion</div>
                            <div style="font-size:.82rem; color:var(--color-text-secondary)">Animales disponibles hoy</div>
                        </div>
                    </div>
                    <p style="font-size:.88rem; color:var(--color-text-secondary); margin:0">
                        <i class="bi bi-info-circle me-1"></i>
                        Los datos se actualizan en tiempo real desde nuestra base de datos.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════ CTA REGISTRO ═══════════ -->
@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <section class="home-account-cta">
        <div class="container text-center">
            <i class="bi bi-stars" style="font-size:2.5rem; color:var(--color-accent-light); display:block; margin-bottom:16px"></i>
            <h2 style="color:white; font-size:2rem; font-weight:800; margin-bottom:12px">
                ¿Primera vez aquí?
            </h2>
            <p style="color:rgba(255,255,255,.7); font-size:1.05rem; max-width:500px; margin:0 auto 28px">
                Crea tu cuenta gratis y gestiona la salud de tus mascotas en línea.
                Agenda citas, revisa historial y solicita adopciones.
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Register" class="btn-hf-primary">
                    <i class="bi bi-person-plus-fill"></i> Crear cuenta gratis
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-hf-outline" style="color:white; border-color:rgba(255,255,255,.4)">
                    <i class="bi bi-box-arrow-in-right"></i> Ya tengo cuenta
                </a>
            </div>
        </div>
    </section>
}

<!-- ═══════════ CONTACTO ═══════════ -->
<section id="contacto" class="section-gray home-contact-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-label"><i class="bi bi-chat-dots"></i> Estamos aquí</span>
            <h2 class="section-title">Contáctanos</h2>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-3 col-sm-6">
                <div class="service-card">
                    <div class="sc-icon" style="background:var(--color-accent-lighter)">
                        <i class="bi bi-geo-alt-fill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h6 style="font-weight:700">Dirección</h6>
                    <p style="color:var(--color-text-secondary); font-size:.88rem; margin:0">Av. Amazonas y Naciones Unidas<br>Quito, Ecuador</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="service-card">
                    <div class="sc-icon" style="background:var(--color-info-bg)">
                        <i class="bi bi-telephone-fill" style="color:var(--color-primary); font-size:1.4rem"></i>
                    </div>
                    <h6 style="font-weight:700">Teléfono</h6>
                    <p style="color:var(--color-text-secondary); font-size:.88rem; margin:0">(02) 234-5678<br>099-123-4567</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="service-card">
                    <div class="sc-icon" style="background:var(--color-warning-bg)">
                        <i class="bi bi-clock-fill" style="color:var(--color-warning); font-size:1.4rem"></i>
                    </div>
                    <h6 style="font-weight:700">Horario</h6>
                    <p style="color:var(--color-text-secondary); font-size:.88rem; margin:0">Lun – Vie: 8:00 – 20:00<br>Sáb – Dom: 9:00 – 16:00</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="service-card">
                    <div class="sc-icon" style="background:#fce7f3">
                        <i class="bi bi-envelope-fill" style="color:#db2777; font-size:1.5rem"></i>
                    </div>
                    <h6 style="font-weight:700">Email</h6>
                    <p style="color:var(--color-text-secondary); font-size:.88rem; margin:0">info@huellitas.ec<br>adopciones@huellitas.ec</p>
                </div>
            </div>
        </div>
    </div>
</section>
</main>
