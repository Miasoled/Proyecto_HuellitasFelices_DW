@{
    ViewData["Title"] = "Pago cancelado";
}

<div class="page-header"><div class="container">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item active">Pago cancelado</li>
    </ol></nav>
    <h1><i class="bi bi-x-circle me-2"></i>Pago cancelado</h1>
</div></div>

<div class="content-wrapper"><div class="container">
<div class="row justify-content-center"><div class="col-lg-6 text-center">
    <div class="hf-card p-5">
        <i class="bi bi-x-octagon" style="font-size:4rem; color:var(--warning);"></i>
        <h3 class="mt-3">Pago cancelado</h3>
        <p class="text-muted mt-2">Has cancelado el proceso de pago. No se realizó ningún cobro.</p>
        <p class="text-muted">Puedes intentar nuevamente cuando lo desees.</p>
        <div class="d-flex gap-3 justify-content-center mt-4">
            <a asp-controller="Account" asp-action="MiPanel" class="btn-primary-hf" style="padding:12px 28px;">
                <i class="bi bi-house me-1"></i>Volver a mi panel
            </a>
        </div>
    </div>
</div></div></div></div>
