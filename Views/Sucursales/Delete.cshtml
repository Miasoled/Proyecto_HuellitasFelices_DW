@model HuellitasFelices.Models.Sucursal
@{
    ViewData["Title"] = "Eliminar Sucursal";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sucursales</a></li>
            <li class="breadcrumb-item active">Eliminar</li>
        </ol></nav>
        <h1><i class="bi bi-trash me-2"></i>Eliminar Sucursal</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="hf-card" style="max-width:700px">
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div>
                <strong>¿Está seguro que desea eliminar esta sucursal?</strong><br />
                <small>Esta acción marcará la sucursal como inactiva.</small>
            </div>
        </div>
        <dl class="row mb-4">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@(Model.Direccion ?? "—")</dd>
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn-search" style="background-color:#dc3545;border-color:#dc3545"><i class="bi bi-trash"></i> Eliminar</button>
                <a asp-action="Index" class="btn-back">Cancelar</a>
            </div>
        </form>
    </div>
</div></div>
