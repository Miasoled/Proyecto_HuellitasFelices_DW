@model HuellitasFelices.Models.Sucursal
@{ ViewData["Title"] = "Eliminar sucursal"; }

<section class="container py-4">
    <h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Eliminar Sucursal</h2>
    <hr />

    <div class="alert alert-warning">
        ¿Está seguro que desea eliminar la sucursal <strong>@Model.Nombre</strong>?
        Esta acción ocultará la sucursal de los listados pero conservará los registros asociados.
    </div>

    <div class="card shadow-sm" style="max-width:500px">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>
                <dt class="col-sm-4">Ciudad</dt>
                <dd class="col-sm-8">@Model.Ciudad</dd>
                <dt class="col-sm-4">Dirección</dt>
                <dd class="col-sm-8">@Model.Direccion</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3 d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmar eliminación</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</section>
