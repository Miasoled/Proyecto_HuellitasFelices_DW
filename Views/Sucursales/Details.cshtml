@model HuellitasFelices.Models.Sucursal
@{ ViewData["Title"] = "Detalles de sucursal"; }

<section class="container py-4">
    <h2><i class="bi bi-building"></i> Detalles de Sucursal</h2>
    <hr />

    <div class="card shadow-sm" style="max-width:600px">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Nombre</dd>

                <dt class="col-sm-4">Ciudad</dt>
                <dd class="col-sm-8">@Model.Ciudad</dd>

                <dt class="col-sm-4">Dirección</dt>
                <dd class="col-sm-8">@Model.Direccion</dd>

                <dt class="col-sm-4">Teléfono</dt>
                <dd class="col-sm-8">@Model.Telefono</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Es principal</dt>
                <dd class="col-sm-8">
                    @if (Model.EsPrincipal)
                    {
                        <span class="badge bg-success"><i class="bi bi-star-fill"></i> Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">
                        @(Model.Activo ? "Activa" : "Inactiva")
                    </span>
                </dd>

                <dt class="col-sm-4">Fecha creación</dt>
                <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Editar
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</section>
