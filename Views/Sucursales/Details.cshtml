@model HuellitasFelices.Models.Sucursal
@{
    ViewData["Title"] = "Detalle Sucursal";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sucursales</a></li>
            <li class="breadcrumb-item active">Detalle</li>
        </ol></nav>
        <h1><i class="bi bi-eye me-2"></i>@Model.Nombre</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="hf-card" style="max-width:700px">
        <h5 class="mb-3">Información de la Sucursal</h5>
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt>
            <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>
            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@(Model.Direccion ?? "—")</dd>
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
            <dt class="col-sm-4">Fecha creación</dt>
            <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-search"><i class="bi bi-pencil"></i> Editar</a>
        <a asp-action="Index" class="btn-back">Volver</a>
    </div>
</div></div>
