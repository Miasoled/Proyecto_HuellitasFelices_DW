@model IEnumerable<HuellitasFelices.Models.Sucursal>
@using HuellitasFelices.Models
@{
    ViewData["Title"] = "Sucursales";
    var p = ViewBag.Paginacion as PaginacionViewModel;
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">Sucursales</li>
        </ol></nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-building me-2"></i>Sucursales</h1>
                <small style="opacity:.8">@(p?.TotalRegistros.ToString("N0") ?? "–") sucursales</small>
            </div>
            <a asp-action="Create" class="btn-hero-primary"><i class="bi bi-plus-lg"></i> Nueva sucursal</a>
        </div>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <form method="get" class="search-bar d-flex gap-2 flex-wrap">
            <input type="text" name="busqueda" value="@p?.Busqueda" class="form-control" placeholder="Buscar sucursal…" style="min-width:250px" />
            <button type="submit" class="btn-search"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>Nombre</th><th>Dirección</th><th>Teléfono</th><th>Inventario</th><th style="width:130px">Acciones</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nombre</strong></td>
                        <td>@(item.Direccion ?? "—")</td>
                        <td>@(item.Telefono ?? "—")</td>
                        <td>@item.Inventarios.Count</td>
                        <td><div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view"><i class="bi bi-eye"></i></a>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
    @if (p != null) { @await Html.PartialAsync("_Paginacion", p) }
</div></div>
