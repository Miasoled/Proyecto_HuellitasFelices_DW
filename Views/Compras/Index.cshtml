@model IEnumerable<HuellitasFelices.Models.Compra>
@using HuellitasFelices.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Compras";
    var p = ViewBag.Paginacion as PaginacionViewModel;
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Inventario" asp-action="Index">Inventario</a></li>
            <li class="breadcrumb-item active">Compras</li>
        </ol></nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-cart-check me-2"></i>Compras</h1>
                <small style="opacity:.8">@(p?.TotalRegistros.ToString("N0") ?? "–") compras</small>
            </div>
            <a asp-action="Create" class="btn-hero-primary"><i class="bi bi-plus-lg"></i> Nueva compra</a>
        </div>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <form method="get" class="search-bar d-flex gap-2 flex-wrap">
            <input type="text" name="busqueda" value="@p?.Busqueda" class="form-control" placeholder="Buscar compra…" style="min-width:250px" />
            <select name="estado" class="form-select" style="width:auto">
                <option value="">Todas</option>
                <option value="Pendiente">Pendiente</option>
                <option value="Recibida">Recibida</option>
                <option value="Cancelada">Cancelada</option>
            </select>
            <button type="submit" class="btn-search"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <div class="hf-card"><div class="table-responsive">
        <table class="hf-table">
            <thead><tr>
                <th>N° Compra</th><th>Proveedor</th><th>Sucursal</th><th>Total</th><th>Estado</th><th>Fecha</th><th style="width:130px">Acciones</th>
            </tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var badgeClass = item.Estado switch
                    {
                        "Pendiente" => "badge-warning-hf",
                        "Recibida" => "badge-success-hf",
                        "Cancelada" => "badge-danger-hf",
                        _ => ""
                    };
                    <tr>
                        <td><code>@item.NumeroCompra</code></td>
                        <td>@item.Proveedor?.Nombre</td>
                        <td>@item.Sucursal?.Nombre</td>
                        <td>$@item.Total.ToString("N2")</td>
                        <td><span class="badge @badgeClass">@item.Estado</span></td>
                        <td>@item.FechaCompra.ToString("dd/MM/yyyy")</td>
                        <td><div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-view"><i class="bi bi-eye"></i></a>
                        </div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
    @if (p != null) { @await Html.PartialAsync("_Paginacion", p) }
</div></div>
