@model HuellitasFelices.Models.Consulta
@{ ViewData["Title"] = "Nueva consulta"; }
<div class="page-header"><div class="container">
    <nav aria-label="breadcrumb"><ol class="breadcrumb mb-2">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Consultas</a></li>
        <li class="breadcrumb-item active">Nueva</li>
    </ol></nav>
    <h1><i class="bi bi-calendar-plus-fill me-2"></i>Agendar Consulta Médica</h1>
</div></div>
<div class="content-wrapper"><div class="container">
<div class="row justify-content-center"><div class="col-lg-7">
    <div class="hf-card">
        <div class="hf-card-header"><i class="bi bi-clipboard2-pulse me-2"></i>Datos de la consulta</div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="MascotaId" class="form-label"><i class="bi bi-patch-heart me-1"></i>Mascota</label>
                        <select asp-for="MascotaId" asp-items="ViewBag.MascotaId" class="form-select" required>
                            <option value="">-- Seleccione una mascota --</option>
                        </select>
                        <span asp-validation-for="MascotaId" class="text-danger" style="font-size:.82rem"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Motivo" class="form-label"><i class="bi bi-chat-left-text me-1"></i>Motivo de la consulta</label>
                        <input asp-for="Motivo" class="form-control" placeholder="Ej: Control de rutina, Vacunación, Dolor de estómago..." required />
                        <span asp-validation-for="Motivo" class="text-danger" style="font-size:.82rem"></span>
                    </div>
                    
                    <div class="col-12">
                        <label asp-for="Sintomas" class="form-label"><i class="bi bi-activity me-1"></i>Síntomas observados</label>
                        <textarea asp-for="Sintomas" class="form-control" rows="3" placeholder="Describa los síntomas de la mascota (Ej: no quiere comer, tiene decaimiento, bota saliva, etc.)..."></textarea>
                        <span asp-validation-for="Sintomas" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="VeterinarioId" class="form-label"><i class="bi bi-person-badge me-1"></i>Veterinario asignado</label>
                        <select asp-for="VeterinarioId" asp-items="ViewBag.VeterinarioId" class="form-select" required>
                            <option value="">-- Seleccione un veterinario --</option>
                        </select>
                        <span asp-validation-for="VeterinarioId" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    @if (!User.IsInRole("Cliente"))
                    {
                        <!-- Solo visible para personal de la clínica -->
                        <div class="col-12">
                            <label asp-for="Diagnostico" class="form-label"><i class="bi bi-clipboard2-check me-1"></i>Diagnóstico médico</label>
                            <textarea asp-for="Diagnostico" class="form-control" rows="3" placeholder="Resultados de la revisión y diagnóstico…"></textarea>
                            <span asp-validation-for="Diagnostico" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Costo" class="form-label"><i class="bi bi-cash me-1"></i>Costo ($)</label>
                            <input asp-for="Costo" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Costo" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="FechaConsulta" class="form-label"><i class="bi bi-calendar3 me-1"></i>Fecha y hora</label>
                        <input asp-for="FechaConsulta" class="form-control" type="datetime-local" required />
                        <span asp-validation-for="FechaConsulta" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    <div class="col-12 d-flex gap-3 pt-3 border-top" style="border-color: var(--border) !important;">
                        <button type="submit" class="btn-primary-hf"><i class="bi bi-check-lg"></i> Confirmar Cita</button>
                        <a asp-action="Index" class="btn-outline-hf"><i class="bi bi-arrow-left"></i> Cancelar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
