@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-key-fill"></i></div>
            <div class="login-tagline">¿Olvidaste tu contraseña?</div>
            <p class="login-sub">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container">
            <div class="login-form-title">Recuperar acceso</div>
            <p class="login-form-sub">Te enviaremos las instrucciones a tu correo</p>

            <form asp-page="./ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size:.82rem"></span>
                </div>

                <button type="submit" class="btn-hf-primary w-100 justify-content-center" style="padding:13px">
                    <i class="bi bi-send-fill"></i> Enviar enlace de recuperación
                </button>
            </form>

            <div style="text-align:center; margin-top:24px; padding-top:20px; border-top:1px solid var(--color-border)">
                <a asp-page="./Login" class="btn-hf-outline" style="padding:7px 16px; text-decoration:none; display:inline-flex; align-items:center; gap:6px">
                    <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
