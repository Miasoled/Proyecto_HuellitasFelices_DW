@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de recuperación";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <a class="login-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Ir al inicio de Huellitas Felices">
                <span class="login-logo"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>Huellitas Felices</span>
            </a>
            <div class="auth-illustration"><i class="bi bi-key-fill"></i></div>
            <div class="login-tagline">Código de recuperación</div>
            <p class="login-sub">Ingresa uno de tus códigos de recuperación para acceder a tu cuenta.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container">
            <span class="auth-eyebrow"><i class="bi bi-life-preserver"></i> Acceso alternativo</span>
            <div class="login-form-title">Código de recuperación</div>
            <p class="login-form-sub">Cada código solo se puede usar una vez</p>

            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Input.RecoveryCode" class="form-label"><i class="bi bi-key me-1"></i>Código de recuperación</label>
                    <input asp-for="Input.RecoveryCode" class="form-control text-center"
                           placeholder="XXXX-XXXX-XXXX" autocomplete="off" autofocus
                           style="font-size:1.1rem; letter-spacing:2px" />
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger" style="font-size:.82rem"></span>
                    <div class="form-text">Cada código de recuperación solo se puede usar una vez.</div>
                </div>

                <button type="submit" class="btn-hf-primary w-100 justify-content-center" style="padding:13px">
                    <i class="bi bi-check-lg"></i> Ingresar
                </button>
            </form>

            <div class="auth-help-links">
                <a asp-page="LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl"
                   style="font-size:.85rem; color:var(--color-primary); text-decoration:none; font-weight:500">
                    Usar código de autenticación
                </a>
                <a asp-page="Login" style="font-size:.85rem; color:var(--color-text-secondary); text-decoration:none">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
