@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-shield-check"></i></div>
            <div class="login-tagline">¡Contraseña cambiada!</div>
            <p class="login-sub">Tu contraseña ha sido actualizada con éxito. Ya puedes iniciar sesión.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container" style="text-align:center">
            <div style="width:64px;height:64px;background:var(--color-success-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                <i class="bi bi-check-circle-fill" style="font-size:2rem;color:var(--color-success)"></i>
            </div>
            <div class="login-form-title">Contraseña actualizada</div>
            <p class="login-form-sub">Tu contraseña ha sido restablecida con éxito</p>

            <p style="color:var(--color-text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:28px">
                Ya puedes iniciar sesión con tus nuevas credenciales de acceso.
            </p>

            <div style="padding-top:20px; border-top:1px solid var(--color-border)">
                <a asp-page="./Login" class="btn-hf-primary w-100 justify-content-center" style="padding:12px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión ahora
                </a>
            </div>
        </div>
    </div>
    </section>
</div>
