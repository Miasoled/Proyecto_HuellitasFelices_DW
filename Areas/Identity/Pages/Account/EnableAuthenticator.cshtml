@page
@model HuellitasFelices.Areas.Identity.Pages.Account.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar autenticador";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-shield-lock me-2"></i>Configurar autenticador</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="hf-card">
                <div class="hf-card-header"><i class="bi bi-shield-lock me-2"></i>Configurar autenticador</div>
                <div class="p-4">
                    <p>Para usar la autenticación multifactor, siga estos pasos:</p>
                    <ol style="padding-left:20px; display:flex; flex-direction:column; gap:16px; margin-bottom:24px">
                        <li style="font-size:.9rem">
                            Descargue una aplicación autenticadora como <strong>Google Authenticator</strong> o <strong>Microsoft Authenticator</strong>.
                        </li>
                        <li style="font-size:.9rem">
                            Escanee el código QR o ingrese manualmente la clave:
                            <div class="text-center mt-3 mb-3">
                                <div id="qrcode" style="display:inline-block"></div>
                            </div>
                            <div class="mt-2 p-3 rounded text-center" style="background:var(--color-bg)">
                                <small style="color:var(--color-text-secondary)" class="d-block mb-1">Clave manual:</small>
                                <code style="font-size:1.1rem; letter-spacing:2px">@Model.SharedKey</code>
                            </div>
                        </li>
                        <li style="font-size:.9rem">
                            Ingrese el código de 6 dígitos que muestra la aplicación:
                            <form method="post" class="mt-3">
                                <input type="hidden" name="SharedKey" value="@Model.SharedKey" />
                                <input type="hidden" name="AuthenticatorUri" value="@Model.AuthenticatorUri" />
                                <div class="d-flex gap-2" style="max-width:320px">
                                    <input type="text" name="Code" class="form-control form-control-lg text-center"
                                           placeholder="000000" maxlength="7" autocomplete="off" required />
                                    <button type="submit" class="btn-hf-primary">
                                        <i class="bi bi-check-lg"></i> Verificar
                                    </button>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <div class="text-danger mt-2">@Model.ErrorMessage</div>
                                }
                            </form>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    new QRCode(document.getElementById("qrcode"), {
        text: "@Model.AuthenticatorUri",
        width: 200,
        height: 200,
        correctLevel: QRCode.CorrectLevel.M
    });
</script>
