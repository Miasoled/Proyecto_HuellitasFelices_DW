@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="login-wrapper">
    <section class="login-card" aria-label="Acceso a Huellitas Felices">
    <div class="login-left">
        <div class="login-left-content">
            <a class="login-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Ir al inicio de Huellitas Felices">
                <span class="login-logo"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>Huellitas Felices</span>
            </a>
            <div class="login-tagline">Tu mejor amigo,<br />siempre cuidado.</div>
            <p class="login-sub">
                Gestiona la salud y el bienestar de tus mascotas desde un solo lugar.
            </p>
            <img class="login-logo-image" src="~/images/logo_huellitas.png" alt="Logo de Huellitas Felices" />
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container">
            <div class="login-form-title">Iniciar sesión</div>
            <p class="login-form-sub">Ingresa con tu correo y contraseña</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                </div>
            }

            <form asp-page="./Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size:.82rem"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i>Contraseña</label>
                    <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size:.82rem"></span>
                </div>
                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check" style="margin-bottom:0">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label" style="font-size:.9rem">Recordarme</label>
                    </div>
                    <a asp-page="./ForgotPassword" style="font-size:.85rem; color:var(--color-primary); text-decoration:none; font-weight:500">¿Olvidaste tu contraseña?</a>
                </div>
                <button type="submit" class="btn-hf-primary w-100 justify-content-center" style="padding:13px">
                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                </button>
            </form>

            <div style="display:flex; align-items:center; gap:10px; margin:20px 0">
                <hr style="flex:1; border-color:var(--color-border)" />
                <span style="color:var(--color-text-secondary); font-size:.82rem">o</span>
                <hr style="flex:1; border-color:var(--color-border)" />
            </div>

            <form asp-page="./ExternalLogin" method="post">
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn-hf-outline w-100 justify-content-center" style="padding:11px">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" style="margin-right:6px">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                    </svg>
                    Continuar con Google
                </button>
            </form>

            <div style="text-align:center; margin-top:24px; padding-top:20px; border-top:1px solid var(--color-border)">
                <span style="color:var(--color-text-secondary); font-size:.9rem">¿Eres cliente nuevo?</span>
                <a asp-page="./Register" class="btn-hf-outline ms-2" style="padding:7px 16px; font-size:.88rem">
                    <i class="bi bi-person-plus"></i> Regístrate gratis
                </a>
            </div>
        </div>
    </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
