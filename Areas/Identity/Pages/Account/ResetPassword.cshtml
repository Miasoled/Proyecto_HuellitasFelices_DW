@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div style="background:var(--gray-50); min-height:calc(100vh - 120px); display:flex; align-items:center; padding:40px 16px">
    <div style="width:100%; max-width:440px; margin:0 auto">
        <div class="login-card">
            <div class="login-card-header">
                <div style="width:56px;height:56px;background:rgba(255,255,255,.2);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
                    <i class="bi bi-shield-lock-fill" style="font-size:1.6rem; color:white"></i>
                </div>
                <h4>Restablecer contraseña</h4>
                <p>Ingresa tu nueva contraseña</p>
            </div>
            <div class="card-body" style="padding: 28px 32px 32px;">
                <form asp-page="./ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                    <input type="hidden" asp-for="Input.Token" />
                    <input type="hidden" asp-for="Input.Email" />

                    <p style="color:var(--text-soft); font-size:0.9rem; margin-bottom:20px; text-align:center">
                        Estás restableciendo la contraseña para: <br />
                        <strong style="color:var(--text-dark)">@Model.Input.Email</strong>
                    </p>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i>Nueva contraseña</label>
                        <input asp-for="Input.Password" class="form-control" placeholder="Mín. 8 caracteres" />
                        <span asp-validation-for="Input.Password" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirmar contraseña</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repite la contraseña" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:.82rem"></span>
                    </div>

                    <button type="submit" class="btn-primary-hf w-100 justify-content-center" style="padding:13px; display:inline-flex; align-items:center; gap:8px">
                        <i class="bi bi-check-circle-fill"></i> Cambiar contraseña
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
