@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-shield-lock-fill"></i></div>
            <div class="login-tagline">Restablecer contraseña</div>
            <p class="login-sub">Ingresa tu nueva contraseña para recuperar el acceso a tu cuenta.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container">
            <div class="login-form-title">Nueva contraseña</div>
            <p class="login-form-sub">Elige una contraseña segura que no hayas usado antes</p>

            <form asp-page="./ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>
                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.Email" />

                <p style="color:var(--color-text-secondary); font-size:0.9rem; margin-bottom:20px; text-align:center">
                    Restableciendo para: <strong style="color:var(--color-primary-dark)">@Model.Input.Email</strong>
                </p>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i>Nueva contraseña</label>
                    <input asp-for="Input.Password" class="form-control" placeholder="Mín. 8 caracteres" />
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size:.82rem"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirmar contraseña</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repite la contraseña" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:.82rem"></span>
                </div>

                <button type="submit" class="btn-hf-primary w-100 justify-content-center" style="padding:13px">
                    <i class="bi bi-check-circle-fill"></i> Cambiar contraseña
                </button>
            </form>
        </div>
    </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
