@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-envelope-check-fill"></i></div>
            <div class="login-tagline">¡Verifica tu correo!</div>
            <p class="login-sub">Casi hemos terminado. Revisa tu bandeja de entrada para activar tu cuenta.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container" style="text-align:center">
            <div style="width:64px;height:64px;background:var(--color-success-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                <i class="bi bi-check-circle-fill" style="font-size:2rem;color:var(--color-success)"></i>
            </div>
            <div class="login-form-title">Casi listo</div>
            <p class="login-form-sub">Hemos enviado un correo de confirmación</p>

            <p style="color:var(--color-text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:20px">
                Para activar tu cuenta y poder agendar citas y solicitar adopciones,
                por favor haz clic en el enlace de verificación que enviamos a:
            </p>
            <p style="font-weight:700; color:var(--color-primary); font-size:1.05rem; word-break:break-all; margin-bottom:20px">@Model.Email</p>

            <p style="color:var(--color-text-secondary); font-size:0.85rem; line-height:1.5; margin-bottom:24px">
                Si no encuentras el correo en unos minutos, asegúrate de revisar la carpeta de <strong>correo no deseado (spam)</strong>.
            </p>

            <div style="padding-top:20px; border-top:1px solid var(--color-border); display:flex; gap:12px; justify-content:center">
                <a asp-page="./Login" class="btn-hf-primary" style="padding:10px 20px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-hf-outline" style="padding:10px 20px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                    <i class="bi bi-house"></i> Inicio
                </a>
            </div>
        </div>
    </div>
    </section>
</div>
