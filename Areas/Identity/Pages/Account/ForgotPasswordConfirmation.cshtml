@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Correo de recuperación enviado";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-envelope-check-fill"></i></div>
            <div class="login-tagline">Correo enviado</div>
            <p class="login-sub">Revisa tu bandeja de entrada para continuar con el proceso de recuperación.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container" style="text-align:center">
            <div style="width:64px;height:64px;background:var(--color-success-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                <i class="bi bi-check-circle-fill" style="font-size:2rem;color:var(--color-success)"></i>
            </div>
            <div class="login-form-title">Enlace enviado</div>
            <p class="login-form-sub">Las instrucciones para recuperar tu contraseña están en camino</p>

            <p style="color:var(--color-text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:20px">
                Por favor revisa la bandeja de entrada de <strong>tu correo</strong>.
                Te hemos enviado un enlace que te permitirá restablecer tu contraseña de forma segura.
            </p>
            <p style="color:var(--color-text-secondary); font-size:0.85rem; line-height:1.5; margin-bottom:24px">
                Si no recibes el correo en unos minutos, revisa tu carpeta de <strong>correo no deseado (spam)</strong>.
            </p>

            <div style="padding-top:20px; border-top:1px solid var(--color-border)">
                <a asp-page="./Login" class="btn-hf-primary w-100 justify-content-center" style="padding:12px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                    <i class="bi bi-box-arrow-in-right"></i> Ir al inicio de sesión
                </a>
            </div>
        </div>
    </div>
    </section>
</div>
