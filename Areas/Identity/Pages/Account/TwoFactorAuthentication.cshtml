@page
@model HuellitasFelices.Areas.Identity.Pages.Account.TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Configuración de cuenta";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-gear me-2"></i>Configuración de cuenta</h1>
    </div>
</div>

<div class="content-wrapper"><div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-3 mb-4">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                </div>
            }

            <div class="hf-card mb-4">
                <div class="hf-card-header"><i class="bi bi-key me-2" style="color:var(--color-primary)"></i>Contraseña</div>
                <div class="d-flex align-items-center justify-content-between p-4">
                    <div>
                        <p class="mb-0 fw-semibold">Cambiar tu contraseña</p>
                        <small style="color:var(--color-text-secondary)">Actualiza la contraseña de acceso a tu cuenta</small>
                    </div>
                    <a asp-controller="Account" asp-action="CambiarPassword" class="btn-hf-outline">
                        <i class="bi bi-pencil-square me-1"></i> Cambiar
                    </a>
                </div>
            </div>

            <div class="hf-card">
                <div class="hf-card-header"><i class="bi bi-shield-lock me-2" style="color:var(--color-success)"></i>Autenticación multifactor (MFA)</div>
                <div class="p-4">
                    @if (Model.IsEnabled)
                    {
                        <div class="alert alert-success rounded-3">
                            <i class="bi bi-shield-check me-2"></i>
                            <strong>MFA está habilitado</strong> en su cuenta.
                        </div>

                        @if (Model.RecoveryCodes != null && Model.RecoveryCodes.Any())
                        {
                            <div style="border:1.5px solid var(--color-warning-bg); border-radius:var(--radius); overflow:hidden; margin-bottom:20px">
                                <div style="background:var(--color-warning-bg); padding:12px 16px; font-weight:700; display:flex; align-items:center; gap:8px">
                                    <i class="bi bi-key me-2"></i>Códigos de recuperación
                                </div>
                                <div class="p-3">
                                    <p style="color:var(--color-text-secondary); margin-bottom:12px">Guarde estos códigos en un lugar seguro. Cada código solo se puede usar una vez.</p>
                                    <div class="row">
                                        @foreach (var code in Model.RecoveryCodes)
                                        {
                                            <div class="col-md-4 mb-2">
                                                <code class="d-block p-2 rounded text-center" style="background:var(--color-bg)">@code</code>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <form asp-page-handler="ResetAuthenticator" method="post">
                                <button type="submit" class="btn-hf-outline"><i class="bi bi-arrow-clockwise me-1"></i> Regenerar claves</button>
                            </form>
                            <form asp-page-handler="Disable2fa" method="post">
                                <button type="submit" class="btn-hf-danger"><i class="bi bi-x-lg me-1"></i> Desactivar MFA</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning rounded-3 mb-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>MFA no está habilitado.</strong> Se recomienda activar la autenticación multifactor para mayor seguridad.
                        </div>

                        <a asp-page="EnableAuthenticator" class="btn-hf-primary btn-lg">
                            <i class="bi bi-shield-plus me-2"></i> Activar MFA
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div></div>
