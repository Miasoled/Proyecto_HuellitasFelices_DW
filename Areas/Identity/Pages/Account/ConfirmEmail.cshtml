@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmación de correo electrónico";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-logo"><i class="bi bi-patch-check-fill"></i></div>
            @if (Model.Succeeded)
            {
                <div class="login-tagline">¡Correo verificado!</div>
                <p class="login-sub">Tu cuenta ha sido activada con éxito. Ya puedes acceder a todos los servicios.</p>
            }
            else
            {
                <div class="login-tagline">Error de verificación</div>
                <p class="login-sub">No se pudo confirmar tu correo electrónico. Intenta nuevamente.</p>
            }
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container" style="text-align:center">
            @if (Model.Succeeded)
            {
                <div style="width:64px;height:64px;background:var(--color-success-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                    <i class="bi bi-check-circle-fill" style="font-size:2rem;color:var(--color-success)"></i>
                </div>
                <div class="login-form-title">¡Cuenta activada!</div>
                <p class="login-form-sub">Tu dirección de correo ha sido confirmada exitosamente</p>

                <p style="color:var(--color-text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:28px">
                    Ya puedes iniciar sesión para acceder a tu panel, agendar consultas médicas y gestionar tus solicitudes de adopción.
                </p>

                <div style="padding-top:20px; border-top:1px solid var(--color-border)">
                    <a asp-page="./Login" class="btn-hf-primary w-100 justify-content-center" style="padding:12px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión ahora
                    </a>
                </div>
            }
            else
            {
                <div style="width:64px;height:64px;background:var(--color-danger-bg);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px">
                    <i class="bi bi-x-circle-fill" style="font-size:2rem;color:var(--color-danger)"></i>
                </div>
                <div class="login-form-title">Error de verificación</div>
                <p class="login-form-sub">No se pudo confirmar tu correo electrónico</p>

                <p style="color:var(--color-text-secondary); font-size:0.95rem; line-height:1.6; margin-bottom:20px">
                    @Model.Message
                </p>
                <p style="color:var(--color-text-secondary); font-size:0.85rem; line-height:1.5; margin-bottom:24px">
                    El enlace de confirmación puede haber expirado o ser inválido. Intenta registrarte nuevamente.
                </p>

                <div style="padding-top:20px; border-top:1px solid var(--color-border); display:flex; gap:12px; justify-content:center">
                    <a asp-page="./Register" class="btn-hf-danger" style="padding:10px 20px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                        <i class="bi bi-person-plus-fill"></i> Ir al registro
                    </a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-hf-outline" style="padding:10px 20px; text-decoration:none; display:inline-flex; align-items:center; gap:8px">
                        <i class="bi bi-house"></i> Inicio
                    </a>
                </div>
            }
        </div>
    </div>
    </section>
</div>
