@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Verificación multifactor";
}

<div class="login-wrapper">
    <section class="login-card login-card-compact">
    <div class="login-left">
        <div class="login-left-content">
            <a class="login-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Ir al inicio de Huellitas Felices">
                <span class="login-logo"><i class="bi bi-heart-pulse-fill"></i></span>
                <span>Huellitas Felices</span>
            </a>
            <div class="auth-illustration"><i class="bi bi-shield-lock-fill"></i></div>
            <div class="login-tagline">Verificación en dos pasos</div>
            <p class="login-sub">Ingresa el código de 6 dígitos generado por tu aplicación autenticadora.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-form-container">
            <span class="auth-eyebrow"><i class="bi bi-shield-check"></i> Paso de seguridad</span>
            <div class="login-form-title">Código de verificación</div>
            <p class="login-form-sub">Abre tu app autenticadora e ingresa el código</p>

            <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <input type="hidden" asp-for="RememberMe" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.AuthenticatorCode" class="form-label">
                        <i class="bi bi-key me-1"></i>Código de 6 dígitos
                    </label>
                    <input asp-for="Input.AuthenticatorCode" class="form-control auth-code-input"
                           placeholder="000000" maxlength="7" inputmode="numeric" autocomplete="one-time-code" autofocus />
                    <span asp-validation-for="Input.AuthenticatorCode" class="text-danger" style="font-size:.82rem"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input asp-for="Input.RememberMachine" class="form-check-input" />
                        <label asp-for="Input.RememberMachine" class="form-check-label" style="font-size:.9rem">Recordar este dispositivo</label>
                    </div>
                </div>

                <button type="submit" class="btn-hf-primary w-100 justify-content-center" style="padding:13px">
                    <i class="bi bi-check-lg"></i> Verificar
                </button>
            </form>

            <div class="auth-help-links">
                <a asp-page="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl"
                   style="font-size:.85rem; color:var(--color-primary); text-decoration:none; font-weight:500">
                    Usar código de recuperación
                </a>
                <a asp-page="Login" style="font-size:.85rem; color:var(--color-text-secondary); text-decoration:none">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
    </section>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
