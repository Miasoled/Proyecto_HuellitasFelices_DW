@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div style="background:var(--gray-50); min-height:calc(100vh - 120px); display:flex; align-items:center; padding:40px 16px">
    <div style="width:100%; max-width:480px; margin:0 auto">
        <div class="login-card">
            <div class="login-card-header">
                <div style="width:56px;height:56px;background:rgba(255,255,255,.2);border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
                    <i class="bi bi-person-plus-fill" style="font-size:1.6rem; color:white"></i>
                </div>
                <h4>Crear cuenta de cliente</h4>
                <p>Agenda citas, solicita adopciones y más</p>
            </div>
            <div class="card-body">
                <form asp-page="./Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.NombreCompleto" class="form-label"><i class="bi bi-person me-1"></i>Nombre completo</label>
                        <input asp-for="Input.NombreCompleto" class="form-control" placeholder="Juan Pérez" />
                        <span asp-validation-for="Input.NombreCompleto" class="text-danger" style="font-size:.82rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo electrónico</label>
                        <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Input.Email" class="text-danger" style="font-size:.82rem"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Telefono" class="form-label"><i class="bi bi-phone me-1"></i>Teléfono</label>
                        <input asp-for="Input.Telefono" class="form-control" placeholder="0991234567" />
                        <span asp-validation-for="Input.Telefono" class="text-danger" style="font-size:.82rem"></span>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i>Contraseña</label>
                            <input asp-for="Input.Password" class="form-control" placeholder="Mín. 8 caracteres" />
                            <span asp-validation-for="Input.Password" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirmar</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repite la contraseña" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:.82rem"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn-primary-hf w-100 justify-content-center" style="padding:13px">
                        <i class="bi bi-person-check-fill"></i> Crear mi cuenta
                    </button>
                </form>

                <div style="display:flex; align-items:center; gap:10px; margin:20px 0">
                    <hr style="flex:1; border-color:var(--border)" />
                    <span style="color:var(--text-soft); font-size:.82rem">o</span>
                    <hr style="flex:1; border-color:var(--border)" />
                </div>

                <form asp-page="./ExternalLogin" method="post">
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="btn-outline-hf w-100 justify-content-center" style="padding:11px">
                        <i class="bi bi-google"></i> Registrarse con Google
                    </button>
                </form>
            </div>
            <div style="padding:16px 32px 24px; text-align:center; border-top:1px solid var(--border)">
                <span style="color:var(--text-soft); font-size:.9rem">¿Ya tienes cuenta?</span>
                <a asp-page="./Login" class="btn-outline-hf ms-2" style="padding:7px 16px; font-size:.88rem">
                    <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
